<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================================================
       Editor 4a design tokens (Kanagawa-style dark theme).
       See docs/design/editor-4a/README.md §Design tokens. Keys mirror the handoff token names.
       Reference these as {DynamicResource Bg.Window} etc. so a future theme swap is one-file.
       ============================================================================================ -->

  <!-- Surfaces -->
  <SolidColorBrush x:Key="Bg.Window"      Color="#16161D"/>  <!-- title bar, rail, status bar, menus, results header -->
  <SolidColorBrush x:Key="Bg.Chrome"      Color="#181820"/>  <!-- toolbar, side panels, tab strip -->
  <SolidColorBrush x:Key="Bg.Editor"      Color="#1F1F28"/>  <!-- editor + results body, active tab fill, window body -->
  <SolidColorBrush x:Key="Bg.LineActive"  Color="#252535"/>  <!-- current-line highlight -->
  <SolidColorBrush x:Key="Bg.TileActive"  Color="#2A2A37"/>  <!-- active rail tile, active pill/toggle -->
  <SolidColorBrush x:Key="Bg.Select"      Color="#223249"/>  <!-- selected list row -->
  <SolidColorBrush x:Key="Bg.Hover"       Color="#20202A"/>  <!-- rail/menu row hover -->

  <!-- Borders -->
  <SolidColorBrush x:Key="Border"         Color="#2A2A37"/>  <!-- 1px region separators -->
  <SolidColorBrush x:Key="Border.Control" Color="#363646"/>  <!-- input / button / dropdown borders -->

  <!-- Text -->
  <SolidColorBrush x:Key="Text.Primary"   Color="#DCD7BA"/>
  <SolidColorBrush x:Key="Text.Code"      Color="#C8C093"/>
  <SolidColorBrush x:Key="Text.Muted"     Color="#9D967F"/>
  <SolidColorBrush x:Key="Text.Dim"       Color="#727169"/>
  <SolidColorBrush x:Key="Text.Faint"     Color="#54546D"/>

  <!-- Accents / syntax / status -->
  <SolidColorBrush x:Key="Accent.Orange"  Color="#FF9E3B"/>  <!-- active rail icon, unsaved dot, active toggle -->
  <SolidColorBrush x:Key="Syntax.Keyword" Color="#957FB8"/>
  <SolidColorBrush x:Key="Syntax.Func"    Color="#7E9CD8"/>
  <SolidColorBrush x:Key="Syntax.Number"  Color="#FFA066"/>
  <SolidColorBrush x:Key="Syntax.Table"   Color="#6A9589"/>
  <SolidColorBrush x:Key="Syntax.TableSel" Color="#7AA89F"/>
  <SolidColorBrush x:Key="Ok.Green"       Color="#98BB6C"/>
  <SolidColorBrush x:Key="Error.Red"      Color="#C34043"/>

  <!-- Geometry (design §Geometry) -->
  <x:Double x:Key="Radius.Control">7</x:Double>
  <x:Double x:Key="Radius.Tile">9</x:Double>
  <x:Double x:Key="Height.TitleBar">36</x:Double>
  <x:Double x:Key="Height.Toolbar">46</x:Double>
  <x:Double x:Key="Height.TabStrip">40</x:Double>
  <x:Double x:Key="Width.Rail">52</x:Double>
  <x:Double x:Key="Width.SidePanel">262</x:Double>

</ResourceDictionary>
