<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        x:Class="Squirrel.App.Views.HistoryWindow"
        Width="880" Height="620"
        Title="Query history">

  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Padding="8" BorderBrush="#33888888" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox x:Name="SearchBox" Width="520" Watermark="tokens over past SQL (e.g. film join)…"
                 KeyDown="OnSearchKeyDown"/>
        <Button Content="Search" Click="OnSearchClick" Margin="6,0,0,0"/>
      </StackPanel>
    </Border>

    <Grid RowDefinitions="*,Auto,2*">
      <DataGrid x:Name="HistoryGrid" Grid.Row="0"
                AutoGenerateColumns="False" IsReadOnly="True"
                CanUserResizeColumns="True" GridLinesVisibility="Horizontal"
                SelectionChanged="OnSelectionChanged" DoubleTapped="OnRowActivated" Margin="4">
        <DataGrid.Columns>
          <DataGridTextColumn Header="When" Binding="{Binding ExecutedAt}" Width="150"/>
          <DataGridTextColumn Header="Connection" Binding="{Binding ConnectionName}" Width="130"/>
          <DataGridTextColumn Header="Rows" Binding="{Binding RowCount}" Width="70"/>
          <DataGridTextColumn Header="ms" Binding="{Binding DurationMs}" Width="70"/>
          <DataGridTextColumn Header="OK" Binding="{Binding Ok}" Width="45"/>
          <DataGridTextColumn Header="SQL" Binding="{Binding Preview}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>

      <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows" Background="#33888888"/>

      <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" Margin="4">
        <TextBlock x:Name="DetailsText" Grid.Row="0" Opacity="0.75" Margin="2,2,2,4"
                   Text="Select a query to preview it."/>
        <ae:TextEditor x:Name="PreviewEditor" Grid.Row="1"
                       IsReadOnly="True"
                       ShowLineNumbers="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="13"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
          <TextBlock Text="Double-click a row or use the button →" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,8,0"/>
          <Button x:Name="LoadButton" Content="Load into editor" Click="OnLoadClick" IsEnabled="False"/>
        </StackPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
