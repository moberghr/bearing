<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:vm="using:Squirrel.App.ViewModels"
        x:Class="Squirrel.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1000" Height="700"
        Title="{Binding Title}">

  <DockPanel LastChildFill="True">

    <!-- Connection bar -->
    <Border DockPanel.Dock="Top" Padding="8" BorderBrush="#33888888" BorderThickness="0,0,0,1">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding Host}" Width="130" Margin="0,0,8,0"/>
        <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding Port}" Width="70" Margin="0,0,8,0"/>
        <TextBlock Text="Database" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding Database}" Width="120" Margin="0,0,8,0"/>
        <TextBlock Text="User" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding User}" Width="100" Margin="0,0,8,0"/>
        <TextBlock Text="Password" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding Password}" PasswordChar="•" Width="110" Margin="0,0,8,0"/>
        <Button x:Name="ConnectButton" Content="Connect" Click="OnConnectClick" Margin="0,0,8,0"/>
        <Button x:Name="RunButton" Content="Run (F5)" Click="OnRunClick" Margin="0,0,16,0"/>
        <Button x:Name="OpenButton" Content="Open" Click="OnOpenClick" Margin="0,0,4,0"/>
        <Button x:Name="SaveButton" Content="Save" Click="OnSaveClick" Margin="0,0,4,0"/>
        <Button x:Name="HistoryButton" Content="History" Click="OnHistoryClick"/>
      </WrapPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderBrush="#33888888" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
    </Border>

    <!-- Editor + results -->
    <Grid RowDefinitions="2*,Auto,3*">
      <ae:TextEditor x:Name="Editor" Grid.Row="0"
                     ShowLineNumbers="True"
                     FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                     FontSize="14"
                     Margin="4"/>

      <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows" Background="#33888888"/>

      <DataGrid x:Name="ResultsGrid" Grid.Row="2"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserResizeColumns="True"
                CanUserReorderColumns="True"
                GridLinesVisibility="All"
                Margin="4"/>
    </Grid>

  </DockPanel>
</Window>
