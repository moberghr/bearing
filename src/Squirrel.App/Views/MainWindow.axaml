<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:controls="using:Squirrel.App.Controls"
        xmlns:vm="using:Squirrel.App.ViewModels"
        xmlns:data="using:Squirrel.Core.Data"
        x:Class="Squirrel.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Width="1120" Height="760"
        Background="{DynamicResource Bg.Editor}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="/Assets/squirrel.ico"
        Title="{Binding Title}">


  <Window.Styles>
    <!-- Toolbar pill selectors: compact, rounded, token-colored ComboBoxes. -->
    <Style Selector="ComboBox.pill">
      <Setter Property="Background" Value="{DynamicResource Bg.Editor}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- Rail icon paths inherit the tile's Foreground so they recolor on hover/active. -->
    <Style Selector="RadioButton.rail Path, Button.rail Path">
      <Setter Property="Stroke" Value="{Binding $parent[TemplatedControl].Foreground}"/>
      <Setter Property="StrokeThickness" Value="1.6"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
    </Style>

    <!-- History rows: selected = wave-blue fill + 2px orange left border (design §4). -->
    <Style Selector="ListBox.history > ListBoxItem">
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="BorderThickness" Value="2,0,0,0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.history > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Bg.Select}"/>
    </Style>
    <Style Selector="ListBox.history > ListBoxItem:selected">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Orange}"/>
    </Style>

    <!-- Result-set tabs (TabControl/TabItem): same compact underline style as the editor tabs. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="NaN"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="Opacity" Value="0.65"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="{DynamicResource Bg.Editor}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ConnectionBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">

    <!-- Alt-toggled menu bar (design §Interactions): hidden by default. Docked above the toolbar so it
         sits at the very top when shown. Open/Save live only here. -->
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" IsVisible="{Binding IsMenuVisible}" Background="{DynamicResource Bg.Window}"
          BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
      <!-- InputGesture text is set in code from the active keymap (see SyncMenuGestures) so the menu
           can never drift from the real bindings. -->
      <MenuItem Header="_File">
        <MenuItem x:Name="MenuNewQuery" Header="New Query" Click="OnNewTabClick"/>
        <MenuItem x:Name="MenuOpen" Header="Open…" Click="OnOpenClick"/>
        <Separator/>
        <MenuItem x:Name="MenuSave" Header="Save" Click="OnSaveClick"/>
        <MenuItem x:Name="MenuSaveAs" Header="Save As…" Click="OnSaveAsClick"/>
        <Separator/>
        <MenuItem x:Name="MenuCloseTab" Header="Close Tab" Click="OnCloseCurrentTabClick"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="MenuRenameTab" Header="Rename Tab…" Click="OnMenuRenameTabClick"/>
        <Separator/>
        <MenuItem x:Name="MenuKeybindings" Header="Keyboard Shortcuts…" Click="OnEditKeybindingsClick"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="MenuToggleSidePane" Header="Toggle Side Pane" Click="OnToggleSidePane"/>
        <Separator/>
        <MenuItem Header="Schema" Click="OnMenuSchemaClick"/>
        <MenuItem Header="Scripts" Click="OnMenuScriptsClick"/>
        <MenuItem Header="History" Click="OnHistoryClick"/>
      </MenuItem>
      <MenuItem Header="_Query">
        <MenuItem x:Name="MenuRun" Header="Run" Click="OnRunClick"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="About Squirrel" Click="OnAboutClick"/>
      </MenuItem>
    </Menu>

    <!-- Toolbar (design §Toolbar): proj · | · server · › · database · Run -->
    <Border DockPanel.Dock="Top" Height="46" Padding="8,0" Background="{DynamicResource Bg.Chrome}"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
        <!-- Project selector + overflow (Rename/Open/New live here) -->
        <ComboBox x:Name="ProjectCombo" Classes="pill" Width="200" ItemsSource="{Binding RecentProjects}"
                  SelectionChanged="OnProjectSelectionChanged" ToolTip.Tip="Project">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RecentProjectItem">
              <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Directory}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="⋯" Padding="8,4" ToolTip.Tip="Project actions">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Rename project…" Click="OnRenameProjectClick"/>
              <MenuItem Header="Open project…" Click="OnOpenProjectClick"/>
              <MenuItem Header="New project…" Click="OnNewProjectClick"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Border Width="1" Height="22" Background="{DynamicResource Border}" Margin="4,0"/>

        <!-- Server (connection) -->
        <ComboBox x:Name="ConnectionPicker" Classes="pill" Width="210"
                  ItemsSource="{Binding Connections.Connections}" SelectedItem="{Binding Connections.SelectedTabConnection}"
                  PlaceholderText="— server —" ToolTip.Tip="Server / connection">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="data:ConnectionInfo">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="9" Height="9" CornerRadius="4" VerticalAlignment="Center"
                        Background="{Binding EnvironmentColor, Converter={StaticResource HexBrush}}"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Host}" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource Text.Dim}"/>
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="›" VerticalAlignment="Center" Foreground="{DynamicResource Text.Faint}"/>

        <!-- Database (switchable; lists all DBs on the server). Selection is driven in code-behind
             (SyncDbPicker) because TabDatabases is populated asynchronously, which defeats a plain
             SelectedItem binding's timing. -->
        <ComboBox x:Name="DatabasePicker" Classes="pill" Width="150"
                  ItemsSource="{Binding Connections.TabDatabases}" SelectionChanged="OnDatabaseSelected"
                  PlaceholderText="— db —" ToolTip.Tip="Database (switch DB on this server)"/>

        <!-- Run: understated 30×30 icon button (doubles as Cancel while busy; Esc also cancels) -->
        <Button x:Name="RunButton" Classes="rail" Theme="{StaticResource RailButton}" Width="30" Height="30"
                Click="OnRunClick" Margin="6,0,0,0" ToolTip.Tip="{Binding Execution.RunButtonText}">
          <Path Data="{StaticResource Icon.Run}" Fill="{DynamicResource Ok.Green}" Stretch="Uniform"
                Width="14" Height="14"/>
        </Button>

        <Border Width="1" Height="22" Background="{DynamicResource Border}" Margin="4,0"/>
        <Border Background="{DynamicResource Bg.Editor}" BorderBrush="{DynamicResource Border.Control}"
                BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                ToolTip.Tip="Tap Alt for the menu bar">
          <TextBlock Text="Alt" FontSize="11" Foreground="{DynamicResource Text.Dim}"/>
        </Border>
      </StackPanel>
    </Border>

    <!-- Status bar: 3px ConnectionBrush line across the top edge, then muted metadata. -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{DynamicResource Bg.Window}"
            BorderBrush="{DynamicResource ConnectionBrush}" BorderThickness="0,3,0,0">
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                 Foreground="{DynamicResource Text.Dim}"/>
    </Border>

    <!-- Body: persistent icon rail + swappable 262px side panel + editor workspace -->
    <DockPanel LastChildFill="True">

      <!-- Left rail (design §1): Connections / Scripts / History nav tiles, Settings pinned bottom.
           Clicking a tile activates its panel; re-clicking the active tile collapses the pane
           (OnRailTileClick → ActivateOrTogglePanel). IsChecked is one-way (highlight only). -->
      <Border DockPanel.Dock="Left" Width="52" Background="{DynamicResource Bg.Window}"
              BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,0">
            <!-- App brand mark (non-interactive) pinned at the top of the rail. -->
            <Image Source="{StaticResource SquirrelMark.Amber}" Width="30" Height="30"
                   Margin="0,2,0,10" ToolTip.Tip="Squirrel — SQL Editor"/>
            <RadioButton Classes="rail" Theme="{StaticResource RailTile}" GroupName="rail" Tag="Schema"
                         ToolTip.Tip="Connections" Click="OnRailTileClick">
              <RadioButton.IsChecked>
                <MultiBinding Converter="{StaticResource PanelActive}" ConverterParameter="Schema">
                  <Binding Path="ActivePanel"/>
                  <Binding Path="SidePaneOpen"/>
                </MultiBinding>
              </RadioButton.IsChecked>
              <Path Data="{StaticResource Icon.Database}"/>
            </RadioButton>
            <RadioButton Classes="rail" Theme="{StaticResource RailTile}" GroupName="rail" Tag="Scripts"
                         ToolTip.Tip="Scripts" Click="OnRailTileClick">
              <RadioButton.IsChecked>
                <MultiBinding Converter="{StaticResource PanelActive}" ConverterParameter="Scripts">
                  <Binding Path="ActivePanel"/>
                  <Binding Path="SidePaneOpen"/>
                </MultiBinding>
              </RadioButton.IsChecked>
              <Path Data="{StaticResource Icon.Scripts}"/>
            </RadioButton>
            <RadioButton Classes="rail" Theme="{StaticResource RailTile}" GroupName="rail" Tag="History"
                         ToolTip.Tip="History" Click="OnRailTileClick">
              <RadioButton.IsChecked>
                <MultiBinding Converter="{StaticResource PanelActive}" ConverterParameter="History">
                  <Binding Path="ActivePanel"/>
                  <Binding Path="SidePaneOpen"/>
                </MultiBinding>
              </RadioButton.IsChecked>
              <Path Data="{StaticResource Icon.History}"/>
            </RadioButton>
          </StackPanel>
          <Button Grid.Row="2" Classes="rail" Theme="{StaticResource RailButton}" ToolTip.Tip="Settings"
                  Click="OnSettingsClick" HorizontalAlignment="Center" Margin="0,0,0,8">
            <Path Data="{StaticResource Icon.Settings}"/>
          </Button>
        </Grid>
      </Border>

    <!-- Side panel + workspace -->
    <SplitView IsPaneOpen="{Binding SidePaneOpen}" DisplayMode="Inline" PanePlacement="Left"
               PaneBackground="{DynamicResource Bg.Chrome}"
               OpenPaneLength="{Binding SidePaneWidth}" CompactPaneLength="0">

      <SplitView.Pane>
        <controls:SidebarView x:Name="Sidebar"/>
      </SplitView.Pane>

      <!-- Workspace: tab strip + editor + results -->
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Padding="4,4,4,0" Background="{DynamicResource Bg.Chrome}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal">
            <TabStrip x:Name="TabStrip" ItemsSource="{Binding Workspace.Tabs}" SelectedItem="{Binding Workspace.SelectedTab}">
              <TabStrip.Styles>
                <!-- Compact, underline-style tabs. Retemplated so the only selected marker is a
                     bottom border at the tab's true bottom edge (Fluent's default draws an oversized
                     font plus a mid-tab selection pipe). -->
                <Style Selector="TabStripItem">
                  <Setter Property="FontSize" Value="13"/>
                  <Setter Property="FontWeight" Value="Normal"/>
                  <Setter Property="MinHeight" Value="0"/>
                  <Setter Property="Padding" Value="10,5"/>
                  <Setter Property="Margin" Value="0"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderBrush" Value="Transparent"/>
                  <Setter Property="BorderThickness" Value="0,2,0,0"/>
                  <Setter Property="Foreground" Value="{DynamicResource Text.Dim}"/>
                  <Setter Property="Opacity" Value="0.8"/>
                  <Setter Property="Template">
                    <ControlTemplate>
                      <Border Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="6,6,0,0"
                              Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center"/>
                      </Border>
                    </ControlTemplate>
                  </Setter>
                </Style>
                <Style Selector="TabStripItem:pointerover">
                  <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
                  <Setter Property="Opacity" Value="1"/>
                </Style>
                <!-- Active tab: filled with the editor surface + a 2px top accent in ConnectionBrush. -->
                <Style Selector="TabStripItem:selected">
                  <Setter Property="Background" Value="{DynamicResource Bg.Editor}"/>
                  <Setter Property="BorderBrush" Value="{DynamicResource ConnectionBrush}"/>
                  <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                  <Setter Property="Opacity" Value="1"/>
                </Style>
              </TabStrip.Styles>
              <TabStrip.ItemTemplate>
                <DataTemplate x:DataType="vm:EditorTabViewModel">
                  <StackPanel Orientation="Horizontal" DoubleTapped="OnTabHeaderDoubleTapped">
                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ConnectionColor, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Background="{Binding ConnectionColor, Converter={StaticResource HexBrush}}"/>
                    <TextBlock Text="{Binding Header}" VerticalAlignment="Center"/>
                    <TextBlock Text="●" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent.Orange}" ToolTip.Tip="Unsaved changes"
                               IsVisible="{Binding IsDirty}"/>
                    <!-- Connection name rendered in the connection color (design §5 tab strip). -->
                    <TextBlock Text="{Binding ConnectionDisplay}" FontSize="11" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{Binding ConnectionColor, Converter={StaticResource HexBrush}}"
                               IsVisible="{Binding ConnectionDisplay, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Border Background="Transparent" Cursor="Hand" Width="16" Height="16"
                            Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Close tab"
                            PointerPressed="OnCloseTabPressed">
                      <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#9AA0A6" StrokeThickness="1.4"
                            StrokeLineCap="Round" Stretch="None"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </TabStrip.ItemTemplate>
            </TabStrip>
            <Button Content="+" Click="OnNewTabClick" Padding="8,2" Margin="6,0,0,0"
                    ToolTip.Tip="New editor tab (Ctrl+T)"/>
          </StackPanel>
        </Border>

        <!-- Editor / results split. The results row + splitter start collapsed (SetResultsVisible)
             and only appear once a run produces results; Ctrl+R toggles them thereafter. -->
        <Grid x:Name="WorkspaceGrid" RowDefinitions="2*,Auto,3*">
          <ae:TextEditor x:Name="Editor" Grid.Row="0"
                         ShowLineNumbers="True"
                         FontFamily="{StaticResource MonoFontFamily}"
                         FontSize="14" Margin="4"/>
          <GridSplitter x:Name="ResultsSplitter" Grid.Row="1" Height="4" ResizeDirection="Rows"
                        Background="{DynamicResource Border}"/>
          <controls:ResultView x:Name="ResultsView" Grid.Row="2" Margin="4"/>
        </Grid>
      </DockPanel>

    </SplitView>

    </DockPanel>

  </DockPanel>
</Window>
