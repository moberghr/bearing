<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:vm="using:Squirrel.App.ViewModels"
        xmlns:data="using:Squirrel.Core.Data"
        x:Class="Squirrel.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1120" Height="760"
        Title="{Binding Title}">

  <DockPanel LastChildFill="True">

    <!-- Project bar -->
    <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="#33888888" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <Button Content="☰" Click="OnToggleSidePane" Padding="8,2" Margin="0,0,10,0"
                ToolTip.Tip="Toggle side pane (Ctrl+B)"/>
        <TextBlock Text="Project" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="ProjectCombo" Width="340" ItemsSource="{Binding RecentProjects}"
                  SelectionChanged="OnProjectSelectionChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RecentProjectItem">
              <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Directory}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Rename…" Click="OnRenameProjectClick" Margin="8,0,0,0"/>
        <Button Content="Open…" Click="OnOpenProjectClick" Margin="4,0,0,0"/>
        <Button Content="New…" Click="OnNewProjectClick" Margin="4,0,0,0"/>
        <Button Content="History" Click="OnHistoryClick" Margin="16,0,0,0"/>
      </StackPanel>
    </Border>

    <!-- Action bar: per-tab connection + run/open/save -->
    <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="#33888888" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Connection" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="ConnectionPicker" Width="240"
                  ItemsSource="{Binding Connections}"
                  SelectedItem="{Binding SelectedTabConnection}"
                  PlaceholderText="— none —">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="data:ConnectionInfo">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="9" Height="9" CornerRadius="4" VerticalAlignment="Center"
                        Background="{Binding EnvironmentColor, Converter={StaticResource HexBrush}}"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button x:Name="RunButton" Content="Run (F5)" Click="OnRunClick" Margin="16,0,0,0"/>
        <Button Content="Open" Click="OnOpenClick" Margin="16,0,0,0"/>
        <Button Content="Save" Click="OnSaveClick" Margin="4,0,0,0"/>
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderBrush="#33888888" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
    </Border>

    <!-- Side pane + workspace -->
    <SplitView IsPaneOpen="{Binding SidePaneOpen}" DisplayMode="Inline" PanePlacement="Left"
               OpenPaneLength="{Binding SidePaneWidth}" CompactPaneLength="0">

      <SplitView.Pane>
        <Grid RowDefinitions="Auto,2*,Auto,3*" Margin="6" >

          <!-- Connections -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,4">
            <TextBlock Grid.Column="0" Text="CONNECTIONS" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="＋" Padding="6,0" Click="OnAddConnectionClick"
                    ToolTip.Tip="Add connection"/>
          </Grid>
          <ListBox Grid.Row="1" x:Name="ConnectionsList" ItemsSource="{Binding Connections}"
                   DoubleTapped="OnConnectionActivated">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Use in current tab" Click="OnSetTabConnectionClick"/>
                <MenuItem Header="Edit…" Click="OnEditConnectionClick"/>
                <Separator/>
                <MenuItem Header="Delete" Click="OnDeleteConnectionClick"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="data:ConnectionInfo">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border CornerRadius="4" Padding="5,1" VerticalAlignment="Center" MinWidth="10"
                          IsVisible="{Binding Environment, Converter={x:Static ObjectConverters.IsNotNull}}"
                          Background="{Binding EnvironmentColor, Converter={StaticResource HexBrush}}">
                    <TextBlock Text="{Binding Environment}" FontSize="10" Foreground="White"/>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"/>
                    <TextBlock Text="{Binding Host}" FontSize="11" Opacity="0.55"/>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Scripts -->
          <TextBlock Grid.Row="2" Text="SCRIPTS" FontSize="11" Opacity="0.6" Margin="2,8,2,4"/>
          <ListBox Grid.Row="3" x:Name="ScriptsList" ItemsSource="{Binding Scripts}"
                   DoubleTapped="OnScriptActivated">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Open" Click="OnOpenScriptClick"/>
                <MenuItem Header="Rename…" Click="OnRenameScriptClick"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ScriptItem">
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </SplitView.Pane>

      <!-- Workspace: tab strip + editor + results -->
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Padding="4,4,4,0">
          <StackPanel Orientation="Horizontal">
            <TabStrip x:Name="TabStrip" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
              <TabStrip.ItemTemplate>
                <DataTemplate x:DataType="vm:EditorTabViewModel">
                  <StackPanel Orientation="Horizontal" DoubleTapped="OnTabHeaderDoubleTapped">
                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ConnectionColor, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Background="{Binding ConnectionColor, Converter={StaticResource HexBrush}}"/>
                    <TextBlock Text="{Binding Header}" VerticalAlignment="Center"/>
                    <Button Content="✕" Click="OnCloseTabClick" CommandParameter="{Binding}"
                            Padding="4,0" Margin="6,0,0,0" Background="Transparent" BorderThickness="0"/>
                  </StackPanel>
                </DataTemplate>
              </TabStrip.ItemTemplate>
            </TabStrip>
            <Button Content="+" Click="OnNewTabClick" Padding="8,2" Margin="6,0,0,0"
                    ToolTip.Tip="New editor tab (Ctrl+T)"/>
          </StackPanel>
        </Border>

        <Grid RowDefinitions="2*,Auto,3*">
          <ae:TextEditor x:Name="Editor" Grid.Row="0"
                         ShowLineNumbers="True"
                         FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                         FontSize="14" Margin="4"/>
          <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows" Background="#33888888"/>
          <DataGrid x:Name="ResultsGrid" Grid.Row="2"
                    AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserResizeColumns="True" CanUserReorderColumns="True"
                    GridLinesVisibility="All" Margin="4"/>
        </Grid>
      </DockPanel>

    </SplitView>

  </DockPanel>
</Window>
