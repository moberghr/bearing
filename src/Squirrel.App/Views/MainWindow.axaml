<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:controls="using:Squirrel.App.Controls"
        xmlns:vm="using:Squirrel.App.ViewModels"
        xmlns:data="using:Squirrel.Core.Data"
        x:Class="Squirrel.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1120" Height="760"
        Background="{DynamicResource Bg.Editor}"
        Foreground="{DynamicResource Text.Primary}"
        Title="{Binding Title}">

  <Window.Styles>
    <!-- Result-set tabs (TabControl/TabItem): same compact underline style as the editor tabs. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="NaN"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="Opacity" Value="0.65"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="{DynamicResource Bg.Editor}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ConnectionBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">

    <!-- Project bar -->
    <Border DockPanel.Dock="Top" Padding="8,6" Background="{DynamicResource Bg.Chrome}"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <Button Content="☰" Click="OnToggleSidePane" Padding="8,2" Margin="0,0,10,0"
                ToolTip.Tip="Toggle side pane (Ctrl+B)"/>
        <TextBlock Text="Project" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="ProjectCombo" Width="340" ItemsSource="{Binding RecentProjects}"
                  SelectionChanged="OnProjectSelectionChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RecentProjectItem">
              <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Directory}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Rename…" Click="OnRenameProjectClick" Margin="8,0,0,0"/>
        <Button Content="Open…" Click="OnOpenProjectClick" Margin="4,0,0,0"/>
        <Button Content="New…" Click="OnNewProjectClick" Margin="4,0,0,0"/>
        <Button Content="History" Click="OnHistoryClick" Margin="16,0,0,0"/>
      </StackPanel>
    </Border>

    <!-- Action bar: per-tab connection + run/open/save -->
    <Border DockPanel.Dock="Top" Padding="8,6" Background="{DynamicResource Bg.Chrome}"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Connection" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="ConnectionPicker" Width="240"
                  ItemsSource="{Binding Connections}"
                  SelectedItem="{Binding SelectedTabConnection}"
                  PlaceholderText="— none —">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="data:ConnectionInfo">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="9" Height="9" CornerRadius="4" VerticalAlignment="Center"
                        Background="{Binding EnvironmentColor, Converter={StaticResource HexBrush}}"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button x:Name="RunButton" Content="{Binding RunButtonText}" Click="OnRunClick" Margin="16,0,0,0"/>
        <Button Content="Open" Click="OnOpenClick" Margin="16,0,0,0"/>
        <Button Content="Save" Click="OnSaveClick" Margin="4,0,0,0"/>
      </StackPanel>
    </Border>

    <!-- Status bar: 3px ConnectionBrush line across the top edge, then muted metadata. -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{DynamicResource Bg.Window}"
            BorderBrush="{DynamicResource ConnectionBrush}" BorderThickness="0,3,0,0">
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                 Foreground="{DynamicResource Text.Dim}"/>
    </Border>

    <!-- Side pane + workspace -->
    <SplitView IsPaneOpen="{Binding SidePaneOpen}" DisplayMode="Inline" PanePlacement="Left"
               PaneBackground="{DynamicResource Bg.Chrome}"
               OpenPaneLength="{Binding SidePaneWidth}" CompactPaneLength="0">

      <SplitView.Pane>
        <Grid RowDefinitions="Auto,2*,Auto,3*" Margin="6" >

          <!-- Connections -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,4">
            <TextBlock Grid.Column="0" Text="CONNECTIONS" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource Text.Dim}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="＋" Padding="6,0" Click="OnAddConnectionClick"
                    ToolTip.Tip="Add connection"/>
          </Grid>
          <TreeView Grid.Row="1" x:Name="SchemaTree" ItemsSource="{Binding ServerNodes}">
            <TreeView.Styles>
              <!-- Two-way bind each item's expansion to its node so children load lazily on first expand. -->
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
              </Style>
            </TreeView.Styles>
            <TreeView.DataTemplates>
              <!-- One template for every node type: matched by the base type, so subclasses share it.
                   Leaves have no children, so no expander is shown. -->
              <TreeDataTemplate DataType="vm:SchemaNodeViewModel" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent"
                            DoubleTapped="OnSchemaNodeDoubleTapped">
                  <StackPanel.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Use in current tab" Click="OnUseConnectionInTab" IsVisible="{Binding IsServer}"/>
                      <MenuItem Header="Refresh metadata" Click="OnRefreshServer" IsVisible="{Binding IsServer}"/>
                      <MenuItem Header="Edit…" Click="OnEditServer" IsVisible="{Binding IsServer}"/>
                      <MenuItem Header="Show definition" Click="OnShowDefinition" IsVisible="{Binding CanShowDefinition}"/>
                      <MenuItem Header="Copy name" Click="OnCopyNodeName"/>
                      <Separator IsVisible="{Binding IsServer}"/>
                      <MenuItem Header="Delete" Click="OnDeleteServer" IsVisible="{Binding IsServer}"/>
                    </ContextMenu>
                  </StackPanel.ContextMenu>
                  <Border Width="9" Height="9" CornerRadius="4" VerticalAlignment="Center"
                          IsVisible="{Binding BadgeColor, Converter={x:Static ObjectConverters.IsNotNull}}"
                          Background="{Binding BadgeColor, Converter={StaticResource HexBrush}}"/>
                  <TextBlock Text="{Binding Glyph}" VerticalAlignment="Center" Opacity="0.75"/>
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Detail}" VerticalAlignment="Center" FontSize="11" Opacity="0.5"/>
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.DataTemplates>
          </TreeView>

          <!-- Scripts -->
          <TextBlock Grid.Row="2" Text="SCRIPTS" FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource Text.Dim}" Margin="2,8,2,4"/>
          <ListBox Grid.Row="3" x:Name="ScriptsList" ItemsSource="{Binding Scripts}"
                   DoubleTapped="OnScriptActivated">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Open" Click="OnOpenScriptClick"/>
                <MenuItem Header="Rename…" Click="OnRenameScriptClick"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ScriptItem">
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </SplitView.Pane>

      <!-- Workspace: tab strip + editor + results -->
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Padding="4,4,4,0" Background="{DynamicResource Bg.Chrome}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal">
            <TabStrip x:Name="TabStrip" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
              <TabStrip.Styles>
                <!-- Compact, underline-style tabs. Retemplated so the only selected marker is a
                     bottom border at the tab's true bottom edge (Fluent's default draws an oversized
                     font plus a mid-tab selection pipe). -->
                <Style Selector="TabStripItem">
                  <Setter Property="FontSize" Value="13"/>
                  <Setter Property="FontWeight" Value="Normal"/>
                  <Setter Property="MinHeight" Value="0"/>
                  <Setter Property="Padding" Value="10,5"/>
                  <Setter Property="Margin" Value="0"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderBrush" Value="Transparent"/>
                  <Setter Property="BorderThickness" Value="0,2,0,0"/>
                  <Setter Property="Foreground" Value="{DynamicResource Text.Dim}"/>
                  <Setter Property="Opacity" Value="0.8"/>
                  <Setter Property="Template">
                    <ControlTemplate>
                      <Border Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="6,6,0,0"
                              Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center"/>
                      </Border>
                    </ControlTemplate>
                  </Setter>
                </Style>
                <Style Selector="TabStripItem:pointerover">
                  <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
                  <Setter Property="Opacity" Value="1"/>
                </Style>
                <!-- Active tab: filled with the editor surface + a 2px top accent in ConnectionBrush. -->
                <Style Selector="TabStripItem:selected">
                  <Setter Property="Background" Value="{DynamicResource Bg.Editor}"/>
                  <Setter Property="BorderBrush" Value="{DynamicResource ConnectionBrush}"/>
                  <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                  <Setter Property="Opacity" Value="1"/>
                </Style>
              </TabStrip.Styles>
              <TabStrip.ItemTemplate>
                <DataTemplate x:DataType="vm:EditorTabViewModel">
                  <StackPanel Orientation="Horizontal" DoubleTapped="OnTabHeaderDoubleTapped">
                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ConnectionColor, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Background="{Binding ConnectionColor, Converter={StaticResource HexBrush}}"/>
                    <TextBlock Text="{Binding Header}" VerticalAlignment="Center"/>
                    <TextBlock Text="●" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent.Orange}" ToolTip.Tip="Unsaved changes"
                               IsVisible="{Binding IsDirty}"/>
                    <!-- Connection name rendered in the connection color (design §5 tab strip). -->
                    <TextBlock Text="{Binding ConnectionDisplay}" FontSize="11" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{Binding ConnectionColor, Converter={StaticResource HexBrush}}"
                               IsVisible="{Binding ConnectionDisplay, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Border Background="Transparent" Cursor="Hand" Width="16" Height="16"
                            Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Close tab"
                            PointerPressed="OnCloseTabPressed">
                      <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#9AA0A6" StrokeThickness="1.4"
                            StrokeLineCap="Round" Stretch="None"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </TabStrip.ItemTemplate>
            </TabStrip>
            <Button Content="+" Click="OnNewTabClick" Padding="8,2" Margin="6,0,0,0"
                    ToolTip.Tip="New editor tab (Ctrl+T)"/>
          </StackPanel>
        </Border>

        <Grid RowDefinitions="2*,Auto,3*">
          <ae:TextEditor x:Name="Editor" Grid.Row="0"
                         ShowLineNumbers="True"
                         FontFamily="{StaticResource MonoFontFamily}"
                         FontSize="14" Margin="4"/>
          <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows" Background="{DynamicResource Border}"/>
          <controls:ResultView x:Name="ResultsView" Grid.Row="2" Margin="4"/>
        </Grid>
      </DockPanel>

    </SplitView>

  </DockPanel>
</Window>
