<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:controls="using:Squirrel.App.Controls"
        xmlns:vm="using:Squirrel.App.ViewModels"
        xmlns:data="using:Squirrel.Core.Data"
        x:Class="Squirrel.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1120" Height="760"
        Background="{DynamicResource Bg.Editor}"
        Foreground="{DynamicResource Text.Primary}"
        Title="{Binding Title}">

  <Window.Resources>
    <!-- Left-rail tile: a 36×36 rounded button with just an icon. Idle = dim glyph on transparent;
         hover tints; the checked (active) tile fills Bg.TileActive and turns the glyph orange. -->
    <ControlTheme x:Key="RailTile" TargetType="RadioButton">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Text.Dim}"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="9">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
      </Style>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource Bg.TileActive}"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent.Orange}"/>
      </Style>
    </ControlTheme>

    <!-- Same tile as a plain Button (Settings) — hover only, no checked state. -->
    <ControlTheme x:Key="RailButton" TargetType="Button">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Text.Dim}"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="9">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
      </Style>
    </ControlTheme>

    <!-- History filter pill: small rounded toggle; active segment fills Bg.TileActive. -->
    <ControlTheme x:Key="PillToggle" TargetType="RadioButton">
      <Setter Property="Padding" Value="9,2"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Text.Dim}"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
      </Style>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource Bg.TileActive}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
      </Style>
    </ControlTheme>
  </Window.Resources>

  <Window.Styles>
    <!-- Toolbar pill selectors: compact, rounded, token-colored ComboBoxes. -->
    <Style Selector="ComboBox.pill">
      <Setter Property="Background" Value="{DynamicResource Bg.Editor}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- Rail icon paths inherit the tile's Foreground so they recolor on hover/active. -->
    <Style Selector="RadioButton.rail Path, Button.rail Path">
      <Setter Property="Stroke" Value="{Binding $parent[TemplatedControl].Foreground}"/>
      <Setter Property="StrokeThickness" Value="1.6"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
    </Style>

    <!-- History rows: selected = wave-blue fill + 2px orange left border (design §4). -->
    <Style Selector="ListBox.history > ListBoxItem">
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="BorderThickness" Value="2,0,0,0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.history > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Bg.Select}"/>
    </Style>
    <Style Selector="ListBox.history > ListBoxItem:selected">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Orange}"/>
    </Style>

    <!-- Result-set tabs (TabControl/TabItem): same compact underline style as the editor tabs. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="NaN"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="Opacity" Value="0.65"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="{DynamicResource Bg.Editor}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ConnectionBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">

    <!-- Toolbar (design §Toolbar): proj · | · server · › · database · Run … Focus -->
    <Border DockPanel.Dock="Top" Height="46" Padding="8,0" Background="{DynamicResource Bg.Chrome}"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
        <Button Classes="rail" Theme="{StaticResource RailButton}" Width="30" Height="30"
                Click="OnToggleSidePane" ToolTip.Tip="Toggle side pane (Ctrl+B)">
          <Path Data="M4,7 h16 M4,12 h16 M4,17 h16"/>
        </Button>

        <!-- Project selector + overflow (Rename/Open/New live here) -->
        <ComboBox x:Name="ProjectCombo" Classes="pill" Width="200" ItemsSource="{Binding RecentProjects}"
                  SelectionChanged="OnProjectSelectionChanged" ToolTip.Tip="Project">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RecentProjectItem">
              <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Directory}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="⋯" Padding="8,4" ToolTip.Tip="Project actions">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Rename project…" Click="OnRenameProjectClick"/>
              <MenuItem Header="Open project…" Click="OnOpenProjectClick"/>
              <MenuItem Header="New project…" Click="OnNewProjectClick"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Border Width="1" Height="22" Background="{DynamicResource Border}" Margin="4,0"/>

        <!-- Server (connection) -->
        <ComboBox x:Name="ConnectionPicker" Classes="pill" Width="210"
                  ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedTabConnection}"
                  PlaceholderText="— server —" ToolTip.Tip="Server / connection">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="data:ConnectionInfo">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="9" Height="9" CornerRadius="4" VerticalAlignment="Center"
                        Background="{Binding EnvironmentColor, Converter={StaticResource HexBrush}}"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Host}" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource Text.Dim}"/>
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="›" VerticalAlignment="Center" Foreground="{DynamicResource Text.Faint}"/>

        <!-- Database (switchable; lists all DBs on the server) -->
        <ComboBox x:Name="DatabasePicker" Classes="pill" Width="150"
                  ItemsSource="{Binding TabDatabases}" SelectedItem="{Binding SelectedTabDatabase}"
                  PlaceholderText="— db —" ToolTip.Tip="Database (switch DB on this server)"/>

        <!-- Run: understated 30×30 icon button (doubles as Cancel while busy; Esc also cancels) -->
        <Button x:Name="RunButton" Classes="rail" Theme="{StaticResource RailButton}" Width="30" Height="30"
                Click="OnRunClick" Margin="6,0,0,0" ToolTip.Tip="{Binding RunButtonText}">
          <Path Data="{StaticResource Icon.Run}" Fill="{DynamicResource Ok.Green}" Stretch="Uniform"
                Width="14" Height="14"/>
        </Button>
      </StackPanel>
    </Border>

    <!-- Status bar: 3px ConnectionBrush line across the top edge, then muted metadata. -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{DynamicResource Bg.Window}"
            BorderBrush="{DynamicResource ConnectionBrush}" BorderThickness="0,3,0,0">
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                 Foreground="{DynamicResource Text.Dim}"/>
    </Border>

    <!-- Body: persistent icon rail + swappable 262px side panel + editor workspace -->
    <DockPanel LastChildFill="True">

      <!-- Left rail (design §1): Schema / Scripts / History nav tiles, Settings pinned bottom. -->
      <Border DockPanel.Dock="Left" Width="52" Background="{DynamicResource Bg.Window}"
              BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,0">
            <RadioButton Classes="rail" Theme="{StaticResource RailTile}" GroupName="rail" ToolTip.Tip="Schema"
                         IsChecked="{Binding ActivePanel, Converter={StaticResource EnumToBool}, ConverterParameter=Schema, Mode=TwoWay}">
              <Path Data="{StaticResource Icon.Schema}"/>
            </RadioButton>
            <RadioButton Classes="rail" Theme="{StaticResource RailTile}" GroupName="rail" ToolTip.Tip="Scripts"
                         IsChecked="{Binding ActivePanel, Converter={StaticResource EnumToBool}, ConverterParameter=Scripts, Mode=TwoWay}">
              <Path Data="{StaticResource Icon.Scripts}"/>
            </RadioButton>
            <RadioButton Classes="rail" Theme="{StaticResource RailTile}" GroupName="rail" ToolTip.Tip="History"
                         IsChecked="{Binding ActivePanel, Converter={StaticResource EnumToBool}, ConverterParameter=History, Mode=TwoWay}">
              <Path Data="{StaticResource Icon.History}"/>
            </RadioButton>
          </StackPanel>
          <Button Grid.Row="2" Classes="rail" Theme="{StaticResource RailButton}" ToolTip.Tip="Settings"
                  Click="OnSettingsClick" HorizontalAlignment="Center" Margin="0,0,0,8">
            <Path Data="{StaticResource Icon.Settings}"/>
          </Button>
        </Grid>
      </Border>

    <!-- Side panel + workspace -->
    <SplitView IsPaneOpen="{Binding SidePaneOpen}" DisplayMode="Inline" PanePlacement="Left"
               PaneBackground="{DynamicResource Bg.Chrome}"
               OpenPaneLength="{Binding SidePaneWidth}" CompactPaneLength="0">

      <SplitView.Pane>
        <Grid>

          <!-- ===== Schema panel (connection/schema tree) ===== -->
          <DockPanel Margin="8,8,6,6"
                     IsVisible="{Binding ActivePanel, Converter={StaticResource EnumToBool}, ConverterParameter=Schema}">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2,0,2,6">
              <TextBlock Grid.Column="0" Text="SCHEMA" FontSize="11" FontWeight="Bold"
                         Foreground="{DynamicResource Text.Dim}" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="＋" Padding="6,0" Click="OnAddConnectionClick"
                      ToolTip.Tip="Add connection"/>
            </Grid>
            <TreeView x:Name="SchemaTree" ItemsSource="{Binding ServerNodes}" Background="Transparent">
              <TreeView.Styles>
                <!-- Two-way bind each item's expansion to its node so children load lazily on first expand. -->
                <Style Selector="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                </Style>
              </TreeView.Styles>
              <TreeView.DataTemplates>
                <!-- One template for every node type: matched by the base type, so subclasses share it.
                     Leaves have no children, so no expander is shown. -->
                <TreeDataTemplate DataType="vm:SchemaNodeViewModel" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent"
                              DoubleTapped="OnSchemaNodeDoubleTapped">
                    <StackPanel.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Use in current tab" Click="OnUseConnectionInTab" IsVisible="{Binding IsServer}"/>
                        <MenuItem Header="Refresh metadata" Click="OnRefreshServer" IsVisible="{Binding IsServer}"/>
                        <MenuItem Header="Edit…" Click="OnEditServer" IsVisible="{Binding IsServer}"/>
                        <MenuItem Header="Show definition" Click="OnShowDefinition" IsVisible="{Binding CanShowDefinition}"/>
                        <MenuItem Header="Copy name" Click="OnCopyNodeName"/>
                        <Separator IsVisible="{Binding IsServer}"/>
                        <MenuItem Header="Delete" Click="OnDeleteServer" IsVisible="{Binding IsServer}"/>
                      </ContextMenu>
                    </StackPanel.ContextMenu>
                    <Border Width="9" Height="9" CornerRadius="4" VerticalAlignment="Center"
                            IsVisible="{Binding BadgeColor, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Background="{Binding BadgeColor, Converter={StaticResource HexBrush}}"/>
                    <TextBlock Text="{Binding Glyph}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}"/>
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock Text="{Binding Detail}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Text.Dim}"/>
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </DockPanel>

          <!-- ===== Scripts panel (design §3): folder tree + filter ===== -->
          <DockPanel Margin="8,8,6,6"
                     IsVisible="{Binding ActivePanel, Converter={StaticResource EnumToBool}, ConverterParameter=Scripts}">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="2,0,2,6">
              <TextBlock Grid.Column="0" Text="SCRIPTS" FontSize="11" FontWeight="Bold"
                         Foreground="{DynamicResource Text.Dim}" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Classes="rail" Theme="{StaticResource RailButton}" Width="26" Height="26"
                      Click="OnNewScriptFolderClick" ToolTip.Tip="New folder">
                <Path Data="{StaticResource Icon.Folder}"/>
              </Button>
              <Button Grid.Column="2" Content="＋" Padding="6,0" Click="OnNewTabClick"
                      ToolTip.Tip="New script (Ctrl+T)"/>
            </Grid>
            <TextBox DockPanel.Dock="Top" Text="{Binding ScriptFilter, Mode=TwoWay}"
                     PlaceholderText="Filter scripts…" Margin="0,0,0,6"/>
            <TreeView x:Name="ScriptsTree" ItemsSource="{Binding ScriptNodes}" Background="Transparent">
              <TreeView.Styles>
                <Style Selector="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                </Style>
              </TreeView.Styles>
              <TreeView.DataTemplates>
                <!-- Folder: amber glyph + name + right-aligned count -->
                <TreeDataTemplate DataType="vm:ScriptFolderViewModel" ItemsSource="{Binding Scripts}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Path Grid.Column="0" Data="{StaticResource Icon.Folder}" Stroke="#E6C384"
                          StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform"
                          Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Count}" VerticalAlignment="Center"
                               FontSize="11" Margin="6,0,4,0" Foreground="{DynamicResource Text.Faint}"/>
                  </Grid>
                </TreeDataTemplate>
                <!-- Script leaf: file glyph + name + unsaved dot -->
                <TreeDataTemplate DataType="vm:ScriptItem">
                  <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent"
                              DoubleTapped="OnScriptActivated">
                    <StackPanel.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Open" Click="OnOpenScriptClick"/>
                        <MenuItem Header="Rename…" Click="OnRenameScriptClick"/>
                      </ContextMenu>
                    </StackPanel.ContextMenu>
                    <Path Data="{StaticResource Icon.File}" Stroke="{DynamicResource Text.Dim}"
                          StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform"
                          Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock Text="●" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent.Orange}" ToolTip.Tip="Unsaved changes"
                               IsVisible="{Binding IsUnsaved}"/>
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </DockPanel>

          <!-- ===== History panel (design §4): day-grouped, filterable ===== -->
          <DockPanel Margin="8,8,6,6"
                     IsVisible="{Binding ActivePanel, Converter={StaticResource EnumToBool}, ConverterParameter=History}">
            <TextBlock DockPanel.Dock="Top" Text="HISTORY" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource Text.Dim}" Margin="2,0,2,6"/>
            <TextBox DockPanel.Dock="Top" Text="{Binding History.SearchText, Mode=TwoWay}"
                     PlaceholderText="Search history…" KeyDown="OnHistorySearchKeyDown" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
              <RadioButton Theme="{StaticResource PillToggle}" GroupName="histfilter" Content="All"
                           IsChecked="{Binding History.Filter, Converter={StaticResource EnumToBool}, ConverterParameter=All, Mode=TwoWay}"/>
              <RadioButton Theme="{StaticResource PillToggle}" GroupName="histfilter" Content="✓ ok"
                           IsChecked="{Binding History.Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Ok, Mode=TwoWay}"/>
              <RadioButton Theme="{StaticResource PillToggle}" GroupName="histfilter" Content="✕ error"
                           IsChecked="{Binding History.Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Error, Mode=TwoWay}"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding History.Status}" FontSize="11"
                       Foreground="{DynamicResource Text.Faint}" Margin="2,4,2,0"/>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding History.Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryDayGroup">
                    <StackPanel Margin="0,0,0,8">
                      <TextBlock Text="{Binding Caption}" FontSize="10" FontWeight="Bold"
                                 Foreground="{DynamicResource Text.Faint}" Margin="2,2,2,3"/>
                      <ListBox Classes="history" ItemsSource="{Binding Rows}" Background="Transparent"
                               BorderThickness="0" Padding="0">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:HistoryRowViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent"
                                  DoubleTapped="OnHistoryRowActivated" ToolTip.Tip="{Binding Detail}">
                              <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                      Background="{Binding ConnectionColor, Converter={StaticResource HexBrush}}"/>
                              <TextBlock Grid.Column="1" Text="{Binding DisplayQuery}" TextTrimming="CharacterEllipsis"
                                         FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                         VerticalAlignment="Center"
                                         Foreground="{Binding QueryColorHex, Converter={StaticResource HexBrush}}"/>
                              <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="11" Margin="8,0,0,0"
                                         VerticalAlignment="Center" Foreground="{DynamicResource Text.Faint}"/>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>

        </Grid>
      </SplitView.Pane>

      <!-- Workspace: tab strip + editor + results -->
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Padding="4,4,4,0" Background="{DynamicResource Bg.Chrome}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal">
            <TabStrip x:Name="TabStrip" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
              <TabStrip.Styles>
                <!-- Compact, underline-style tabs. Retemplated so the only selected marker is a
                     bottom border at the tab's true bottom edge (Fluent's default draws an oversized
                     font plus a mid-tab selection pipe). -->
                <Style Selector="TabStripItem">
                  <Setter Property="FontSize" Value="13"/>
                  <Setter Property="FontWeight" Value="Normal"/>
                  <Setter Property="MinHeight" Value="0"/>
                  <Setter Property="Padding" Value="10,5"/>
                  <Setter Property="Margin" Value="0"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderBrush" Value="Transparent"/>
                  <Setter Property="BorderThickness" Value="0,2,0,0"/>
                  <Setter Property="Foreground" Value="{DynamicResource Text.Dim}"/>
                  <Setter Property="Opacity" Value="0.8"/>
                  <Setter Property="Template">
                    <ControlTemplate>
                      <Border Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="6,6,0,0"
                              Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center"/>
                      </Border>
                    </ControlTemplate>
                  </Setter>
                </Style>
                <Style Selector="TabStripItem:pointerover">
                  <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
                  <Setter Property="Opacity" Value="1"/>
                </Style>
                <!-- Active tab: filled with the editor surface + a 2px top accent in ConnectionBrush. -->
                <Style Selector="TabStripItem:selected">
                  <Setter Property="Background" Value="{DynamicResource Bg.Editor}"/>
                  <Setter Property="BorderBrush" Value="{DynamicResource ConnectionBrush}"/>
                  <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                  <Setter Property="Opacity" Value="1"/>
                </Style>
              </TabStrip.Styles>
              <TabStrip.ItemTemplate>
                <DataTemplate x:DataType="vm:EditorTabViewModel">
                  <StackPanel Orientation="Horizontal" DoubleTapped="OnTabHeaderDoubleTapped">
                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ConnectionColor, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Background="{Binding ConnectionColor, Converter={StaticResource HexBrush}}"/>
                    <TextBlock Text="{Binding Header}" VerticalAlignment="Center"/>
                    <TextBlock Text="●" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent.Orange}" ToolTip.Tip="Unsaved changes"
                               IsVisible="{Binding IsDirty}"/>
                    <!-- Connection name rendered in the connection color (design §5 tab strip). -->
                    <TextBlock Text="{Binding ConnectionDisplay}" FontSize="11" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{Binding ConnectionColor, Converter={StaticResource HexBrush}}"
                               IsVisible="{Binding ConnectionDisplay, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Border Background="Transparent" Cursor="Hand" Width="16" Height="16"
                            Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Close tab"
                            PointerPressed="OnCloseTabPressed">
                      <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#9AA0A6" StrokeThickness="1.4"
                            StrokeLineCap="Round" Stretch="None"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </TabStrip.ItemTemplate>
            </TabStrip>
            <Button Content="+" Click="OnNewTabClick" Padding="8,2" Margin="6,0,0,0"
                    ToolTip.Tip="New editor tab (Ctrl+T)"/>
          </StackPanel>
        </Border>

        <Grid RowDefinitions="2*,Auto,3*">
          <ae:TextEditor x:Name="Editor" Grid.Row="0"
                         ShowLineNumbers="True"
                         FontFamily="{StaticResource MonoFontFamily}"
                         FontSize="14" Margin="4"/>
          <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows" Background="{DynamicResource Border}"/>
          <controls:ResultView x:Name="ResultsView" Grid.Row="2" Margin="4"/>
        </Grid>
      </DockPanel>

    </SplitView>

    </DockPanel>

  </DockPanel>
</Window>
