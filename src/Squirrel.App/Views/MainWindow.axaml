<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:vm="using:Squirrel.App.ViewModels"
        x:Class="Squirrel.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1040" Height="740"
        Title="{Binding Title}">

  <DockPanel LastChildFill="True">

    <!-- Project bar -->
    <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="#33888888" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Project" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="ProjectCombo" Width="360" ItemsSource="{Binding RecentProjects}"
                  SelectionChanged="OnProjectSelectionChanged"/>
        <Button Content="Open…" Click="OnOpenProjectClick" Margin="8,0,0,0"/>
        <Button Content="New…" Click="OnNewProjectClick" Margin="4,0,0,0"/>
        <Button Content="History" Click="OnHistoryClick" Margin="16,0,0,0"/>
      </StackPanel>
    </Border>

    <!-- Connection bar -->
    <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="#33888888" BorderThickness="0,0,0,1">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding Host}" Width="120" Margin="0,0,8,0"/>
        <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding Port}" Width="64" Margin="0,0,8,0"/>
        <TextBlock Text="DB" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding Database}" Width="110" Margin="0,0,8,0"/>
        <TextBlock Text="User" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding User}" Width="90" Margin="0,0,8,0"/>
        <TextBlock Text="Pass" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding Password}" PasswordChar="•" Width="100" Margin="0,0,8,0"/>
        <Button x:Name="ConnectButton" Content="Connect" Click="OnConnectClick" Margin="0,0,16,0"/>
        <Button x:Name="RunButton" Content="Run (F5)" Click="OnRunClick" Margin="0,0,16,0"/>
        <Button Content="Open" Click="OnOpenClick" Margin="0,0,4,0"/>
        <Button Content="Save" Click="OnSaveClick"/>
      </WrapPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderBrush="#33888888" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
    </Border>

    <!-- Tab strip -->
    <Border DockPanel.Dock="Top" Padding="4,4,4,0">
      <StackPanel Orientation="Horizontal">
        <TabStrip x:Name="TabStrip" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
          <TabStrip.ItemTemplate>
            <DataTemplate x:DataType="vm:EditorTabViewModel">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Header}" VerticalAlignment="Center"/>
                <Button Content="✕" Click="OnCloseTabClick" CommandParameter="{Binding}"
                        Padding="4,0" Margin="6,0,0,0" Background="Transparent" BorderThickness="0"/>
              </StackPanel>
            </DataTemplate>
          </TabStrip.ItemTemplate>
        </TabStrip>
        <Button Content="+" Click="OnNewTabClick" Padding="8,2" Margin="6,0,0,0"
                ToolTip.Tip="New editor tab"/>
      </StackPanel>
    </Border>

    <!-- Editor + results -->
    <Grid RowDefinitions="2*,Auto,3*">
      <ae:TextEditor x:Name="Editor" Grid.Row="0"
                     ShowLineNumbers="True"
                     FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                     FontSize="14" Margin="4"/>
      <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows" Background="#33888888"/>
      <DataGrid x:Name="ResultsGrid" Grid.Row="2"
                AutoGenerateColumns="False" IsReadOnly="True"
                CanUserResizeColumns="True" CanUserReorderColumns="True"
                GridLinesVisibility="All" Margin="4"/>
    </Grid>

  </DockPanel>
</Window>
