<Project Sdk="Microsoft.NET.Sdk">

  <!-- Thin desktop entry point. All UI lives in Bearing.App. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>bearing</AssemblyName>
    <!-- Win32 icon baked into the .exe (Explorer, taskbar, Alt+Tab). Only has an effect when the
         target produces a Windows apphost; ignored for linux-*/osx-* RIDs. The in-app window icon
         is separate — see Bearing.App/Views/MainWindow.axaml. Forward slashes so the path resolves
         when cross-publishing from Linux. -->
    <ApplicationIcon>../../assets/brand/icons/bearing.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Startup: precompile IL→native on publish (ReadyToRun) to cut JIT time in the ~490ms
       runtime/Avalonia init phase. Applies to `dotnet publish` (the shipped build), not dev run. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bearing.App\Bearing.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <!-- For the VelopackApp hook in Program.Main, which `vpk pack` verifies is in the entry assembly.
         The rest of the update machinery lives in Bearing.Updates behind Core's IUpdateService. -->
    <PackageReference Include="Velopack" />
  </ItemGroup>

</Project>
