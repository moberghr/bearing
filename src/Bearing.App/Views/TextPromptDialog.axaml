<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Bearing.App.Views.TextPromptDialog"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Rename">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock x:Name="PromptText" Text="New name"/>
    <TextBox x:Name="InputBox" KeyDown="OnKeyDown"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancelClick"/>
      <Button Content="OK" Click="OnOkClick" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
