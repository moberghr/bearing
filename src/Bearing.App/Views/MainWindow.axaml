<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:app="using:Bearing.App"
        xmlns:controls="using:Bearing.App.Controls"
        xmlns:vm="using:Bearing.App.ViewModels"
        xmlns:data="using:Bearing.Core.Data"
        x:Class="Bearing.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Width="1120" Height="760"
        Background="{DynamicResource Bg.Editor}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="/Assets/bearing.ico"
        Title="{Binding Title}">


  <Window.Styles>
    <!-- Server dropdown rows carry their own environment fill (issue #45), so the open list reads as a
         stack of environments rather than a column of coloured dots. ReflectionBinding because a Style
         setter inherits the Window's x:DataType (ShellViewModel) and compiled bindings are on by default;
         the row's DataContext is the ConnectionInfo. -->
    <Style Selector="ComboBox#ConnectionPicker ComboBoxItem">
      <Setter Property="Background"
              Value="{ReflectionBinding EnvironmentColor, Converter={StaticResource HexBrush}, ConverterParameter=0.16}"/>
    </Style>

    <!-- Toolbar pill selectors: compact, rounded, token-colored ComboBoxes. -->
    <Style Selector="ComboBox.pill">
      <Setter Property="Background" Value="{DynamicResource Bg.Editor}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- Rail icon paths inherit the tile's Foreground so they recolor on hover/active. Sizing is NOT set
         here: Stretch="Uniform" + a fixed 20×20 box fit each glyph to its own ink bounds rather than to the
         24×24 grid the icons were drawn on, which is what left them optically unaligned (#5). The nav glyphs
         are LineIcons now, and they own their own geometry space (weight included); StrokeThickness below is
         for the Run/Stop glyphs, which are filled shapes sized in device pixels at their call site. -->
    <Style Selector="RadioButton.rail Path, Button.rail Path">
      <Setter Property="Stroke" Value="{Binding $parent[TemplatedControl].Foreground}"/>
      <Setter Property="StrokeThickness" Value="1.6"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
    </Style>

    <!-- Connection toggle: the power symbol, identical in all three states (CONNECTION_STATUS §5). Only
         its stroke colour tracks the state, on the Status.* palette the beacon beside it uses. The glyph
         used to mirror the status icon, which made the toolbar say the same thing twice and left neither
         instance clearly the *control*; the beacon reports, this acts. StrokeThickness is in the geometry's
         own 24-unit space (the Viewbox scales it down with everything else). -->
    <Style Selector="Button#ConnectionToggle Path">
      <Setter Property="Stroke" Value="{DynamicResource Status.Connected}"/>
      <Setter Property="StrokeThickness" Value="2.2"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
    </Style>
    <Style Selector="Button#ConnectionToggle.connecting Path">
      <Setter Property="Stroke" Value="{DynamicResource Status.Connecting}"/>
    </Style>
    <Style Selector="Button#ConnectionToggle.disconnected Path">
      <Setter Property="Stroke" Value="{DynamicResource Status.Disconnected}"/>
    </Style>

    <!-- History rows: selected = steel-blue fill + 2px teal left border (design §4). -->
    <Style Selector="ListBox.history > ListBoxItem">
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="BorderThickness" Value="2,0,0,0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.history > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Bg.Select}"/>
    </Style>
    <Style Selector="ListBox.history > ListBoxItem:selected">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Brand}"/>
    </Style>

    <!-- Result-set tabs (TabControl/TabItem): same compact underline style as the editor tabs. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="NaN"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="Opacity" Value="0.65"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="{DynamicResource Bg.Editor}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ConnectionBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">

    <!-- Menu bar (design §Interactions): hidden by default and revealed by an Alt tap, or pinned open by
         Settings ▸ General ▸ Always show the menu bar. Docked above the toolbar so it sits at the very top
         when shown. Open/Save live only here. -->
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" IsVisible="{Binding IsMenuVisible}" Background="{DynamicResource Bg.Window}"
          BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
      <!-- InputGesture text is set in code from the active keymap (see SyncMenuGestures) so the menu
           can never drift from the real bindings. -->
      <MenuItem Header="_File">
        <MenuItem x:Name="MenuNewQuery" Header="New Query" Click="OnNewTabClick"/>
        <MenuItem x:Name="MenuOpen" Header="Open…" Click="OnOpenClick"/>
        <Separator/>
        <MenuItem x:Name="MenuSave" Header="Save" Click="OnSaveClick"/>
        <MenuItem x:Name="MenuSaveAs" Header="Save As…" Click="OnSaveAsClick"/>
        <Separator/>
        <MenuItem Header="Import connections">
          <MenuItem x:Name="MenuImportDBeaver" Header="From DBeaver…" Click="OnImportDBeaverClick"/>
        </MenuItem>
        <Separator/>
        <MenuItem x:Name="MenuCloseTab" Header="Close Tab" Click="OnCloseCurrentTabClick"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="MenuRenameTab" Header="Rename Tab…" Click="OnMenuRenameTabClick"/>
        <Separator/>
        <MenuItem x:Name="MenuKeybindings" Header="Keyboard Shortcuts…" Click="OnEditKeybindingsClick"/>
        <MenuItem x:Name="MenuSettings" Header="Settings…" Click="OnSettingsClick"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="MenuToggleSidePane" Header="Toggle Side Pane" Click="OnToggleSidePane"/>
        <Separator/>
        <MenuItem Header="Schema" Click="OnMenuSchemaClick"/>
        <MenuItem Header="Scripts" Click="OnMenuScriptsClick"/>
        <MenuItem Header="History" Click="OnHistoryClick"/>
      </MenuItem>
      <MenuItem Header="_Query">
        <MenuItem x:Name="MenuRun" Header="Run" Click="OnRunClick"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Check for Updates…" Command="{Binding Updates.CheckNowCommand}"/>
        <MenuItem Header="What's New" Command="{Binding Updates.WhatsNewCommand}"
                  IsVisible="{Binding Updates.CanShowNotes, FallbackValue=False}"/>
        <Separator/>
        <MenuItem Header="About Bearing" Click="OnAboutClick"/>
      </MenuItem>
    </Menu>

    <!-- Toolbar (design §Toolbar): proj · | · server · › · database · Run -->
    <Border DockPanel.Dock="Top" Height="46" Padding="8,0" Background="{DynamicResource Bg.Chrome}"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
        <!-- Project selector + overflow (Rename/Open/New live here) -->
        <ComboBox x:Name="ProjectCombo" Classes="pill" Width="200" ItemsSource="{Binding RecentProjects}"
                  SelectionChanged="OnProjectSelectionChanged" ToolTip.Tip="Project">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RecentProjectItem">
              <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Directory}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="⋯" Padding="8,4" ToolTip.Tip="Project actions">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Rename project…" Click="OnRenameProjectClick"/>
              <MenuItem Header="Open project…" Click="OnOpenProjectClick"/>
              <MenuItem Header="New project…" Click="OnNewProjectClick"/>
              <Separator/>
              <MenuItem Header="Remove project…" Click="OnRemoveProjectClick"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Border Width="1" Height="22" Background="{DynamicResource Border}" Margin="4,0"/>

        <!-- Server (connection) -->
        <!-- Selection is driven from code-behind (SyncConnectionPicker), not bound: see MainWindow.Chrome.cs. -->
        <!-- Environment is a *surface* here, never a dot (issue #45): a 9px coloured dot in this pill sat
             two controls away from the connection-state dot and read as one, so a green environment meant
             "connected" and a red one "disconnected". The whole pill is now the environment — filled with
             the active connection's colour at 16% and outlined in it (design prototype toolbar: server
             control, background rgba(env,.16), radius 7) — with an azure server glyph where the dot was.
             A filled control can't be mistaken for a status light; an untagged connection fills to
             Transparent and falls back to the bare pill. -->
        <ComboBox x:Name="ConnectionPicker" Classes="pill" Width="210"
                  ItemsSource="{Binding Connections.Connections}" SelectionChanged="OnConnectionSelected"
                  BorderThickness="1"
                  BorderBrush="{Binding Connections.ActiveConnectionColor, Converter={StaticResource HexBrush}}"
                  Background="{Binding Connections.ActiveConnectionColor, Converter={StaticResource HexBrush}, ConverterParameter=0.16}"
                  PlaceholderText="— server —" ToolTip.Tip="Server / connection">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="data:ConnectionInfo">
              <!-- Tooltip is the full endpoint, user@host:port/database — the spelling the credential
                   prompt and the connect-failure message use, so the three name a server identically
                   (#79). Host alone made two instances on one box indistinguishable. -->
              <StackPanel Orientation="Horizontal" Spacing="7"
                          ToolTip.Tip="{Binding Converter={StaticResource ConnectionEndpoint}}">
                <!-- Azure server glyph (Syntax.Func is the token, "server icon" and all). Not a status
                     colour, and not the environment colour: it identifies the control, nothing more. -->
                <!-- Nudged 2px down: Stretch="Uniform" centres the glyph in its box, but a box centred
                     against a text line sits optically high against the letterforms. -->
                <Path Data="{StaticResource Icon.Connections}" Stroke="{DynamicResource Syntax.Func}"
                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,2,0,0"/>
                <!-- Name only — the endpoint is in the tooltip (the status bar shows connection *state*,
                     not the host). 210px fixed: an endpoint here would truncate the names that are the
                     control's whole point. The row is the environment
                     plus its name. Name stays in normal text colour: tinting it with an arbitrary user hex
                     is a contrast hazard on the dark theme, and the report called it out directly. -->
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Connection status: beacon + label, 14px here and 13px in the status bar (design §2). The
             state palette is its own — never the environment's — see ConnectionStatusView. -->
        <controls:ConnectionStatusView VerticalAlignment="Center" BeaconSize="14"/>

        <!-- Connect / cancel-connecting / disconnect toggle. One power glyph for all three; the state is
             read off the beacon to its left, not off this button. -->
        <Button x:Name="ConnectionToggle" Theme="{StaticResource IconToggleButton}" VerticalAlignment="Center"
                Command="{Binding Connections.ToggleConnectionCommand}"
                ToolTip.Tip="{Binding Connections.ToggleTip}"
                Classes.connecting="{Binding Connections.IsConnecting}"
                Classes.disconnected="{Binding Connections.IsDisconnected}">
          <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Pin the Panel to the icons' own 24×24 authoring grid. The power glyph's ink spans
                 x 4..20 / y 3.5..19 — centred on (12,12) in that grid, but with an asymmetric origin
                 offset. Sizing the Panel to the ink instead (no explicit size) loses that centring and the
                 glyph renders off-centre in the button. This Path deliberately has no Stretch so
                 StrokeThickness stays in 24-unit space and the Viewbox scales it down with the geometry. -->
            <Panel Width="24" Height="24">
              <Path Data="{StaticResource Icon.Power}"/>
            </Panel>
          </Viewbox>
        </Button>

        <TextBlock Text="›" VerticalAlignment="Center" Foreground="{DynamicResource Text.Faint}"/>

        <!-- Database (switchable; lists all DBs on the server). Selection is driven in code-behind
             (SyncDbPicker) because TabDatabases is populated asynchronously, which defeats a plain
             SelectedItem binding's timing. -->
        <ComboBox x:Name="DatabasePicker" Classes="pill" Width="150"
                  ItemsSource="{Binding Connections.TabDatabases}" SelectionChanged="OnDatabaseSelected"
                  PlaceholderText="— db —" ToolTip.Tip="Database (switch DB on this server)"/>

        <!-- Run: understated 30×30 icon button. Doubles as Cancel while busy (Esc also cancels): the green
             play triangle swaps to a red stop square while the selected tab's query is in flight. -->
        <Button x:Name="RunButton" Classes="rail" Theme="{StaticResource RailButton}" Width="30" Height="30"
                Click="OnRunClick" Margin="6,0,0,0" ToolTip.Tip="{Binding Execution.RunButtonText}">
          <Panel>
            <Path Data="{StaticResource Icon.Run}" Fill="{DynamicResource Ok.Green}" Stretch="Uniform"
                  Width="14" Height="14" IsVisible="{Binding !Execution.IsBusy}"/>
            <Path Data="{StaticResource Icon.Stop}" Fill="{DynamicResource Error.Red}" Stretch="Uniform"
                  Width="12" Height="12" IsVisible="{Binding Execution.IsBusy}"/>
          </Panel>
        </Button>

        <Border Width="1" Height="22" Background="{DynamicResource Border}" Margin="4,0"/>
        <Border Background="{DynamicResource Bg.Editor}" BorderBrush="{DynamicResource Border.Control}"
                BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                ToolTip.Tip="Tap Alt for the menu bar">
          <TextBlock Text="Alt" FontSize="11" Foreground="{DynamicResource Text.Dim}"/>
        </Border>
      </StackPanel>
    </Border>

    <!-- Status bar: 3px ConnectionBrush (environment color) line across the top edge — the one prominent
         db-color surface, and unconditional: unlike the status dot it stays lit while disconnected, so the
         "what am I pointed at" answer never disappears. Then the status dot + metadata. -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{DynamicResource Bg.Window}"
            BorderBrush="{DynamicResource ConnectionBrush}" BorderThickness="0,3,0,0">
      <DockPanel LastChildFill="True">
        <!-- Running version, pinned right. Static data (AppVersion), so it binds with x:Static rather than
             going through the view-model to carry a constant. Tooltip carries the +git-sha form, which is
             what identifies the exact build in a bug report. -->
        <TextBlock DockPanel.Dock="Right" Text="{x:Static app:AppVersion.Label}"
                   VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"
                   Foreground="{DynamicResource Text.Faint}"
                   ToolTip.Tip="{x:Static app:AppVersion.Full}"/>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <controls:ConnectionStatusView VerticalAlignment="Center" BeaconSize="13"/>
          <TextBlock Text="·" Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                     Foreground="{DynamicResource Text.Dim}"/>
          <!-- Live execution timer: ticks while the selected tab's query runs, hidden otherwise. -->
          <TextBlock Text="{Binding Execution.ElapsedText}" VerticalAlignment="Center"
                     IsVisible="{Binding Execution.IsBusy}"
                     Foreground="{DynamicResource Ok.Green}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Update strip (#20): the only surface auto-update has. Silent unless a newer version is downloading
         or has been staged; Restart closes the window the ordinary way, so the unsaved-work prompt, editor
         flush and session save all still run before the updater takes over. -->
    <Border DockPanel.Dock="Bottom" Padding="10,6" Background="{DynamicResource Bg.Chrome}"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
            IsVisible="{Binding Updates.IsVisible, FallbackValue=False}">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="{Binding Updates.Message}" VerticalAlignment="Center"/>
        <!-- Asked before "restart now?" can be answered: the notes for the version on offer. -->
        <Button Content="What's new?" Padding="8,2" Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource Syntax.Func}"
                Command="{Binding Updates.UpdateNotesCommand}"
                IsVisible="{Binding Updates.CanShowNotes, FallbackValue=False}"/>
        <Button Content="Restart now" Padding="8,2"
                Command="{Binding Updates.RestartCommand}"
                IsVisible="{Binding Updates.CanRestart, FallbackValue=False}"/>
        <Button Content="Later" Padding="8,2"
                Command="{Binding Updates.DismissCommand}"
                IsVisible="{Binding Updates.CanRestart, FallbackValue=False}"/>
      </StackPanel>
    </Border>

    <!-- Body: persistent icon rail + swappable 262px side panel + editor workspace -->
    <DockPanel LastChildFill="True">

      <!-- Left rail (design §1): Connections / Scripts / History nav tiles, Settings pinned bottom.
           Clicking a tile activates its panel; re-clicking the active tile collapses the pane
           (OnRailTileClick → ActivateOrTogglePanel). IsChecked is one-way (highlight only). -->
      <Border DockPanel.Dock="Left" Width="52" Background="{DynamicResource Bg.Window}"
              BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,0">
            <!-- App brand mark (non-interactive) pinned at the top of the rail. -->
            <Image Source="{StaticResource BearingMark.Duo}" Width="30" Height="30"
                   Margin="0,2,0,10" ToolTip.Tip="Bearing — SQL Editor"/>
            <RadioButton Classes="rail" Theme="{StaticResource RailTile}" GroupName="rail" Tag="Schema"
                         ToolTip.Tip="Connections" Click="OnRailTileClick">
              <RadioButton.IsChecked>
                <MultiBinding Converter="{StaticResource PanelActive}" ConverterParameter="Schema">
                  <Binding Path="ActivePanel"/>
                  <Binding Path="SidePaneOpen"/>
                </MultiBinding>
              </RadioButton.IsChecked>
              <controls:LineIcon Data="{StaticResource Icon.Database}"/>
            </RadioButton>
            <RadioButton Classes="rail" Theme="{StaticResource RailTile}" GroupName="rail" Tag="Scripts"
                         ToolTip.Tip="Scripts" Click="OnRailTileClick">
              <RadioButton.IsChecked>
                <MultiBinding Converter="{StaticResource PanelActive}" ConverterParameter="Scripts">
                  <Binding Path="ActivePanel"/>
                  <Binding Path="SidePaneOpen"/>
                </MultiBinding>
              </RadioButton.IsChecked>
              <controls:LineIcon Data="{StaticResource Icon.Scripts}"/>
            </RadioButton>
            <RadioButton Classes="rail" Theme="{StaticResource RailTile}" GroupName="rail" Tag="History"
                         ToolTip.Tip="History" Click="OnRailTileClick">
              <RadioButton.IsChecked>
                <MultiBinding Converter="{StaticResource PanelActive}" ConverterParameter="History">
                  <Binding Path="ActivePanel"/>
                  <Binding Path="SidePaneOpen"/>
                </MultiBinding>
              </RadioButton.IsChecked>
              <controls:LineIcon Data="{StaticResource Icon.History}"/>
            </RadioButton>
          </StackPanel>
          <Button Grid.Row="2" Classes="rail" Theme="{StaticResource RailButton}" ToolTip.Tip="Settings"
                  Click="OnSettingsClick" HorizontalAlignment="Center" Margin="0,0,0,8">
            <controls:LineIcon Data="{StaticResource Icon.Settings}"/>
          </Button>
        </Grid>
      </Border>

    <!-- Side panel + workspace -->
    <SplitView IsPaneOpen="{Binding SidePaneOpen}" DisplayMode="Inline" PanePlacement="Left"
               PaneBackground="{DynamicResource Bg.Chrome}"
               OpenPaneLength="{Binding SidePaneWidth}" CompactPaneLength="0">

      <SplitView.Pane>
        <controls:SidebarView x:Name="Sidebar"/>
      </SplitView.Pane>

      <!-- Workspace: tab strip + editor + results -->
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Padding="4,4,4,0" Background="{DynamicResource Bg.Chrome}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal">
            <TabStrip x:Name="TabStrip" ItemsSource="{Binding Workspace.Tabs}" SelectedItem="{Binding Workspace.SelectedTab}">
              <TabStrip.Styles>
                <!-- Compact, underline-style tabs. Retemplated so the only selected marker is a
                     bottom border at the tab's true bottom edge (Fluent's default draws an oversized
                     font plus a mid-tab selection pipe). -->
                <Style Selector="TabStripItem">
                  <Setter Property="FontSize" Value="13"/>
                  <Setter Property="FontWeight" Value="Normal"/>
                  <Setter Property="MinHeight" Value="0"/>
                  <Setter Property="Padding" Value="10,5"/>
                  <Setter Property="Margin" Value="0"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderBrush" Value="Transparent"/>
                  <Setter Property="BorderThickness" Value="0,2,0,0"/>
                  <Setter Property="Foreground" Value="{DynamicResource Text.Dim}"/>
                  <Setter Property="Opacity" Value="0.8"/>
                  <Setter Property="Template">
                    <ControlTemplate>
                      <Border Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="6,6,0,0"
                              Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center"/>
                      </Border>
                    </ControlTemplate>
                  </Setter>
                </Style>
                <Style Selector="TabStripItem:pointerover">
                  <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
                  <Setter Property="Opacity" Value="1"/>
                </Style>
                <!-- Active tab: filled with the editor surface + a 2px top accent in ConnectionBrush. -->
                <Style Selector="TabStripItem:selected">
                  <Setter Property="Background" Value="{DynamicResource Bg.Editor}"/>
                  <Setter Property="BorderBrush" Value="{DynamicResource ConnectionBrush}"/>
                  <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                  <Setter Property="Opacity" Value="1"/>
                </Style>
              </TabStrip.Styles>
              <TabStrip.ItemTemplate>
                <DataTemplate x:DataType="vm:EditorTabViewModel">
                  <!-- Right-click: Rename / Save / Close / Reveal in Scripts / Open containing folder,
                       built in code-behind for *this* tab (OnTabContextRequested), not the selected one. -->
                  <StackPanel Orientation="Horizontal" DoubleTapped="OnTabHeaderDoubleTapped"
                              ContextRequested="OnTabContextRequested">
                    <!-- Header is the backing file's name (scratch included); the tooltip adds its folder.
                         Renaming swaps the label for a box in place (#39): Enter commits, Esc cancels,
                         clicking away commits. Both live in the tree; only one is visible. -->
                    <TextBlock Text="{Binding Header}" VerticalAlignment="Center"
                               ToolTip.Tip="{Binding HeaderTooltip}"
                               IsVisible="{Binding !IsRenaming}"/>
                    <TextBox Classes="inline" Text="{Binding RenameDraft, Mode=TwoWay}"
                             IsVisible="{Binding IsRenaming}" MinWidth="90" VerticalAlignment="Center"
                             KeyDown="OnTabRenameKeyDown" LostFocus="OnTabRenameLostFocus"/>
                    <!-- Running indicator: a rotating arc while this tab has a query in flight. Execution
                         is per-tab, so a background tab shows progress here without being the focused tab. -->
                    <Path Width="11" Height="11" Margin="6,0,0,0" VerticalAlignment="Center"
                          Stroke="{DynamicResource Syntax.Func}" StrokeThickness="1.5" StrokeLineCap="Round"
                          Data="M 5.5,1 A 4.5,4.5 0 1 1 1,5.5" ToolTip.Tip="Running…"
                          IsVisible="{Binding IsRunning}" RenderTransform="rotate(0)"
                          RenderTransformOrigin="50%,50%">
                      <Path.Styles>
                        <Style Selector="Path">
                          <Style.Animations>
                            <Animation Duration="0:0:0.8" IterationCount="INFINITE">
                              <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                              <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                            </Animation>
                          </Style.Animations>
                        </Style>
                      </Path.Styles>
                    </Path>
                    <TextBlock Text="●" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent.Brand}" ToolTip.Tip="Unsaved changes"
                               IsVisible="{Binding IsDirty}"/>
                    <!-- This tab's connection state, as a bare 12px beacon: no chip, no background, no
                         padding, no border (CONNECTION_STATUS §3.3). It is a live readout, not a badge —
                         if the session drops, every open tab reports it at once. The environment-washed
                         chip it used to sit in is gone: the state palette must never share a surface with
                         the environment palette, and a wash right under the mark is exactly that collision.
                         State is per tab, not the toolbar's: a background tab on another server reads as
                         disconnected while the selected one is live. The connection name lives on as the
                         tooltip — an arbitrary user hex must never tint text (#45). -->
                    <controls:ConnectionBeacon Width="12" Height="12" Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               State="{Binding ConnectionState}"
                                               ToolTip.Tip="{Binding ConnectionDisplay}"
                                               IsVisible="{Binding ConnectionDisplay, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Border Background="Transparent" Cursor="Hand" Width="16" Height="16"
                            Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Close tab"
                            PointerPressed="OnCloseTabPressed">
                      <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#79838F" StrokeThickness="1.4"
                            StrokeLineCap="Round" Stretch="None"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </TabStrip.ItemTemplate>
            </TabStrip>
            <Button Content="+" Click="OnNewTabClick" Padding="8,2" Margin="6,0,0,0"
                    ToolTip.Tip="New editor tab (Ctrl+T)"/>
          </StackPanel>
        </Border>

        <!-- Editor / results split. The results row + splitter start collapsed (SetResultsVisible)
             and only appear once a run produces results; Ctrl+R toggles them thereafter. -->
        <Grid x:Name="WorkspaceGrid" RowDefinitions="2*,Auto,3*">
          <ae:TextEditor x:Name="Editor" Grid.Row="0"
                         ShowLineNumbers="True"
                         FontFamily="{StaticResource MonoFontFamily}"
                         Margin="4"/>
          <GridSplitter x:Name="ResultsSplitter" Grid.Row="1" Height="4" ResizeDirection="Rows"
                        Background="{DynamicResource Border}"/>
          <controls:ResultView x:Name="ResultsView" Grid.Row="2" Margin="4"/>
        </Grid>
      </DockPanel>

    </SplitView>

    </DockPanel>

  </DockPanel>
</Window>
