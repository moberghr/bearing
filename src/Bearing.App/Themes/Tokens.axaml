<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================================================
       Bearing design tokens (graphite surfaces / steel text / one machined-teal accent).
       See docs/design/bearing/README.md §Design tokens. Keys stay semantic, not hue-named, so a
       future re-skin is again a one-file change: reference as {DynamicResource Bg.Window} etc.

       Colour SEMANTICS are unchanged from the previous (Kanagawa) skin — only the hues moved.
       Teal is app state (active nav, unsaved, current line, PK); the per-connection environment
       colour is separate and lives in ConnectionBrush, never in this file.
       ============================================================================================ -->

  <!-- Surfaces (handoff: graphite / ink-*) -->
  <SolidColorBrush x:Key="Bg.Window"      Color="#0F1319"/>  <!-- ink-900: title bar, rail, status bar, menus, results header -->
  <SolidColorBrush x:Key="Bg.Chrome"      Color="#161B21"/>  <!-- ink-800: toolbar, side panels, tab strip -->
  <SolidColorBrush x:Key="Bg.Editor"      Color="#1A2027"/>  <!-- ink-700: editor + results body, active tab fill, window body -->
  <SolidColorBrush x:Key="Bg.LineActive"  Color="#232B36"/>  <!-- current-line highlight, focused cell input -->
  <SolidColorBrush x:Key="Bg.TileActive"  Color="#2A323C"/>  <!-- active rail tile, active pill/toggle segment -->
  <SolidColorBrush x:Key="Bg.Select"      Color="#223440"/>  <!-- selected list row (schema / scripts / history / menu) -->
  <SolidColorBrush x:Key="Bg.Hover"       Color="#222831"/>  <!-- ink-600: rail/menu row hover, quick-stats bar -->

  <!-- Borders -->
  <SolidColorBrush x:Key="Border"         Color="#2A323C"/>  <!-- 1px region separators -->
  <SolidColorBrush x:Key="Border.Control" Color="#333C48"/>  <!-- input / button / dropdown-pill borders -->

  <!-- Text (handoff: steel-*) -->
  <SolidColorBrush x:Key="Text.Primary"   Color="#D8DEE6"/>  <!-- steel-100 -->
  <SolidColorBrush x:Key="Text.Code"      Color="#B7C0CB"/>  <!-- steel-300: code + data values -->
  <SolidColorBrush x:Key="Text.Muted"     Color="#8B95A1"/>  <!-- collapsed tree rows, secondary glyphs -->
  <SolidColorBrush x:Key="Text.Dim"       Color="#79838F"/>  <!-- steel-500: labels, captions, idle glyphs -->
  <SolidColorBrush x:Key="Text.Faint"     Color="#4E5865"/>  <!-- steel-700: line numbers, gutter, disabled, counts -->

  <!-- Accents / syntax / status -->
  <SolidColorBrush x:Key="Accent.Brand"   Color="#35D0BE"/>  <!-- teal: active rail icon, unsaved dot, current-line number, PK badge -->
  <SolidColorBrush x:Key="Syntax.Keyword" Color="#978BE4"/>  <!-- violet: SQL keywords, FK badge -->
  <SolidColorBrush x:Key="Syntax.Func"    Color="#6FA6E2"/>  <!-- azure: functions, server icon, JSON keys, links -->
  <SolidColorBrush x:Key="Syntax.Number"  Color="#E9A46B"/>  <!-- amber: numeric literals -->
  <SolidColorBrush x:Key="Syntax.Table"   Color="#6FB6AB"/>  <!-- mint, tree/table stroke weight -->
  <SolidColorBrush x:Key="Syntax.TableSel" Color="#5FC9AD"/>
  <!-- Ok.Green is deliberately NOT the handoff's mint (#5FC9AD): mint sits too close to Accent.Brand, so
       the Run glyph stopped reading as its own signal against the teal chrome. -->
  <SolidColorBrush x:Key="Ok.Green"       Color="#98BB6C"/>  <!-- run, success, save, timings -->
  <SolidColorBrush x:Key="Warn.Amber"     Color="#E3B457"/>  <!-- gold: folder glyph, warnings -->
  <SolidColorBrush x:Key="Error.Red"      Color="#D2555A"/>  <!-- errors, delete/discard -->

  <!-- Connection *state*, and nothing else (CONNECTION_STATUS rev. 2026-08-27 §1). This is a separate
       palette from the per-connection environment hue on purpose: the environment answers "where am I
       pointed" and owns surfaces (tab washes, rules, the env chip, the status-bar line), while these answer
       "is the session up" and are allowed on icon strokes and label text only. Neither may borrow the
       other's hue — a disconnected production session shows a red beacon on a rose wash.
         · Connecting is blue rather than the gold it used to be because Warn.Amber is #E3B457, which is
           byte-identical to the staging environment colour: "connecting" and "you are on staging" were
           literally the same pixel value.
         · Disconnected is red rather than the grey hollow ring it used to be (#45). That earlier call —
           "red belongs to errors, and a connection that isn't open yet is not an error" — was reversed
           deliberately in the 2026-08-27 handoff, on the grounds that the state palette can no longer be
           confused with an environment now that the two are split. Note Error.Red is #D2555A, close to but
           not equal to this; they are never adjacent.
       Silhouette, not hue, is what actually carries the state — see Controls/ConnectionBeacon. -->
  <SolidColorBrush x:Key="Status.Connected"    Color="#4FC17E"/>
  <SolidColorBrush x:Key="Status.Connecting"   Color="#8FB8E8"/>
  <SolidColorBrush x:Key="Status.Disconnected" Color="#E0483C"/>

  <!-- Geometry (design §Geometry) — unchanged: the Bearing handoff specifies the same metrics. -->
  <x:Double x:Key="Radius.Control">7</x:Double>
  <x:Double x:Key="Radius.Tile">9</x:Double>
  <x:Double x:Key="Height.TitleBar">36</x:Double>
  <x:Double x:Key="Height.Toolbar">46</x:Double>
  <x:Double x:Key="Height.TabStrip">40</x:Double>
  <x:Double x:Key="Width.Rail">52</x:Double>
  <x:Double x:Key="Width.SidePanel">262</x:Double>

</ResourceDictionary>
