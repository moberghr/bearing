<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================================================
       Line-icon geometries (24×24 viewport) drawn as Path Data — stroked, not filled — so they
       recolor with the owning control's Foreground and never depend on a symbol font (the app font
       clips some Unicode glyphs; see result-set FK ↗ note). Used by the left rail + toolbar.
       ============================================================================================ -->

  <!-- Server / connections: two stacked units -->
  <StreamGeometry x:Key="Icon.Connections">M4,6 h16 v4 h-16 z M4,13 h16 v4 h-16 z M7,8 h2 M7,15 h2</StreamGeometry>

  <!-- Schema: a table grid -->
  <StreamGeometry x:Key="Icon.Schema">M4,5 h16 v14 h-16 z M4,10 h16 M4,14.5 h16 M11,5 v14</StreamGeometry>

  <!-- Scripts: a document with a folded corner. Ink spans x 6..18 / y 3..21 — centred on the viewport's
       (12,12), which matters now that the rail renders it on this grid instead of fitting it to its own ink
       bounds (#5): the same drawing shifted one unit right, as it used to be, reads as off-centre in the tile
       next to the clock and the cylinder, both of which are symmetric about (12,12). -->
  <StreamGeometry x:Key="Icon.Scripts">M6,3 h8 l4,4 v14 h-12 z M14,3 v4 h4 M8,12 h6 M8,15 h6 M8,18 h4</StreamGeometry>

  <!-- Folder -->
  <StreamGeometry x:Key="Icon.Folder">M4,7 h6 l2,2 h8 v9 h-16 z</StreamGeometry>

  <!-- File (smaller doc, for script leaves) -->
  <StreamGeometry x:Key="Icon.File">M8,4 h6 l3,3 v13 h-9 z M14,4 v3 h3</StreamGeometry>

  <!-- History: a clock -->
  <StreamGeometry x:Key="Icon.History">M4,12 a8,8 0 1 1 16,0 a8,8 0 1 1 -16,0 M12,7 v5.3 l3.5,2</StreamGeometry>

  <!-- Settings: a cog — closed 6-tooth outline (tips r=9.8, roots r=7.0, arc between teeth) + centre hole.
       Detached radial spokes were tried first and read as a brightness/light-dark toggle, not a cog. -->
  <StreamGeometry x:Key="Icon.Settings">M9.26,5.56 L9.80,2.45 L14.20,2.45 L14.74,5.56 A7.00,7.00 0 0 1 16.21,6.41 L19.17,5.32 L21.37,9.13 L18.95,11.15 A7.00,7.00 0 0 1 18.95,12.85 L21.37,14.87 L19.17,18.68 L16.21,17.59 A7.00,7.00 0 0 1 14.74,18.44 L14.20,21.55 L9.80,21.55 L9.26,18.44 A7.00,7.00 0 0 1 7.79,17.59 L4.83,18.68 L2.63,14.87 L5.05,12.85 A7.00,7.00 0 0 1 5.05,11.15 L2.63,9.13 L4.83,5.32 L7.79,6.41 A7.00,7.00 0 0 1 9.26,5.56 Z M8.80,12.00 a3.2,3.2 0 1 0 6.4,0 a3.2,3.2 0 1 0 -6.4,0</StreamGeometry>

  <!-- Search: magnifier -->
  <StreamGeometry x:Key="Icon.Search">M10,4 a6,6 0 1 1 0,12 a6,6 0 1 1 0,-12 M14.5,14.5 l5,5</StreamGeometry>

  <!-- Run: filled triangle (this one is meant to be filled) -->
  <StreamGeometry x:Key="Icon.Run">M7,5 L18,12 L7,19 Z</StreamGeometry>

  <!-- Stop: filled square (Run button while a query is in flight — cancel) -->
  <StreamGeometry x:Key="Icon.Stop">M6,6 h12 v12 h-12 z</StreamGeometry>

  <!-- Explain: a plan is a tree, so the mark is one — a root that forks to two leaves. Stroked rather than
       filled, like Schema and Connections beside it, so it reads as structure and not as a solid object. -->
  <StreamGeometry x:Key="Icon.Explain">M12,4 v5 M12,9 C12,9 7,9 7,14 M12,9 C12,9 17,9 17,14 M5,14 h4 v5 h-4 z M15,14 h4 v5 h-4 z M10,2 h4 v3 h-4 z</StreamGeometry>

  <!-- Focus: expand arrows -->
  <StreamGeometry x:Key="Icon.Focus">M4,9 v-5 h5 M20,9 v-5 h-5 M4,15 v5 h5 M20,15 v5 h-5</StreamGeometry>

  <!-- Database cylinder (toolbar db pill / tree) -->
  <StreamGeometry x:Key="Icon.Database">M5,6 a7,3 0 1 1 14,0 a7,3 0 1 1 -14,0 M5,6 v12 a7,3 0 0 0 14,0 v-12 M5,12 a7,3 0 0 0 14,0</StreamGeometry>

  <!-- Connect / disconnect toggle: a power symbol — a vertical stem over an open arc. Deliberately the
       *same* mark in every state (CONNECTION_STATUS rev. 2026-08-27 §5): the button is an action, and it
       used to mirror the status glyph, which meant the chrome said the same thing twice and neither
       instance was clearly the control. State lives in the beacon beside it; only this glyph's stroke
       colour tracks it. Replaces Icon.ChainLinked / Icon.ChainBroken, whose two states differed by a gap
       too small to see at 15px. -->
  <StreamGeometry x:Key="Icon.Power">M12,3.5 v6.5 M17.7,7.2 a8,8 0 1 1 -11.4,0</StreamGeometry>

  <!-- ============================================================================================
       Completion-popup kind marks (SuggestionKind → glyph). Same 24×24 stroked convention; drawn at
       14px next to the row label so a table, a column, a keyword and an FK join snippet are
       distinguishable at a glance. Joins get their own mark because accepting one inserts a whole
       JOIN … ON … clause, not just a name.
       ============================================================================================ -->

  <!-- Relation: header row over two columns -->
  <StreamGeometry x:Key="Icon.Table">M4,6 h16 v12 h-16 z M4,10 h16 M9.5,10 v8 M15,10 v8</StreamGeometry>

  <!-- View: a relation frame with an eye — a derived, read-only relation -->
  <StreamGeometry x:Key="Icon.View">M4,6 h16 v12 h-16 z M6.5,12 a5.5,3.2 0 1 0 11,0 a5.5,3.2 0 1 0 -11,0 M11,12 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0</StreamGeometry>

  <!-- Column: one vertical strip of cells -->
  <StreamGeometry x:Key="Icon.Column">M9,4 h6 v16 h-6 z M9,8 h6 M9,12 h6 M9,16 h6</StreamGeometry>

  <!-- Keyword: angle brackets (syntax, not data) -->
  <StreamGeometry x:Key="Icon.Keyword">M9,7 L4,12 L9,17 M15,7 L20,12 L15,17</StreamGeometry>

  <!-- Join: the two-set intersection every FK join draws -->
  <StreamGeometry x:Key="Icon.Join">M5,12 a4.5,4.5 0 1 0 9,0 a4.5,4.5 0 1 0 -9,0 M10,12 a4.5,4.5 0 1 0 9,0 a4.5,4.5 0 1 0 -9,0</StreamGeometry>

  <!-- Function: an f between parentheses -->
  <StreamGeometry x:Key="Icon.Function">M9,18 v-9 a2.5,2.5 0 0 1 2.5,-2.5 M7,12 h5 M16,7 a4.5,5.5 0 0 1 0,10 M4.5,7 a4.5,5.5 0 0 0 0,10</StreamGeometry>

  <!-- Snippet: a braced fragment -->
  <!-- Schema-tree folders under a table (#46). The two foreign-key directions are one arrow each, pointing
       the way the reference does: out of this table, or into it. That direction is the whole distinction
       between "what does this row point at" and "what breaks if I delete it". -->
  <StreamGeometry x:Key="Icon.Key">M6,12 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0 M12,12 h7 M16,12 v3 M19,12 v2.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Index">M5,7 h14 M5,12 h9 M5,17 h5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Constraint">M8,11 h8 v7 h-8 z M9.5,11 v-2.5 a2.5,2.5 0 0 1 5,0 v2.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Trigger">M13,3 L7,13 h4.5 L10.5,21 L17,11 h-4.5 z</StreamGeometry>
  <StreamGeometry x:Key="Icon.ForeignKey">M4,12 h12 M12,8 l4,4 l-4,4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Reference">M20,12 h-12 M12,8 l-4,4 l4,4</StreamGeometry>

  <StreamGeometry x:Key="Icon.Snippet">M10,5 h-2 a2,2 0 0 0 -2,2 v3 a2,2 0 0 1 -2,2 a2,2 0 0 1 2,2 v3 a2,2 0 0 0 2,2 h2 M14,5 h2 a2,2 0 0 1 2,2 v3 a2,2 0 0 0 2,2 a2,2 0 0 0 -2,2 v3 a2,2 0 0 1 -2,2 h-2</StreamGeometry>

</ResourceDictionary>
