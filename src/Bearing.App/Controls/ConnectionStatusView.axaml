<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bearing.App.ViewModels"
             xmlns:controls="using:Bearing.App.Controls"
             x:Class="Bearing.App.Controls.ConnectionStatusView"
             x:DataType="vm:ShellViewModel">

  <!-- Reusable connection-status beacon + label (toolbar at 14px, status bar at 13px).
       Two palettes, no overlap (CONNECTION_STATUS rev. 2026-08-27 §1): the *environment* owns surfaces —
       tab washes, the status-bar rule, the env chip — and the *state* owns this icon and this label, and
       neither borrows the other's hue. That split is what finally settled the older attempt at "Connected
       takes the environment colour", which was tried and rejected here (#45): a live production session
       reading as a red "Connected" was a worse signal than the collision it solved.
       The beacon itself carries the state in its silhouette and colours itself from the Status.* tokens
       (see Controls/ConnectionBeacon); all this view styles is the label beside it. -->
  <UserControl.Styles>
    <!-- Base = Connected. -->
    <Style Selector="TextBlock#Label">
      <Setter Property="Foreground" Value="{DynamicResource Status.Connected}"/>
    </Style>
    <Style Selector="StackPanel.connecting > TextBlock#Label">
      <Setter Property="Foreground" Value="{DynamicResource Status.Connecting}"/>
    </Style>
    <Style Selector="StackPanel.disconnected > TextBlock#Label">
      <Setter Property="Foreground" Value="{DynamicResource Status.Disconnected}"/>
    </Style>
  </UserControl.Styles>

  <!-- MinWidth reserves room for the widest label ("Disconnected") so the adjacent connect/disconnect
       toggle doesn't shift as the state changes (design §3). -->
  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" MinWidth="96"
              Classes.connecting="{Binding Connections.IsConnecting}"
              Classes.disconnected="{Binding Connections.IsDisconnected}"
              ToolTip.Tip="{Binding Connections.StatusLabel}">
    <controls:ConnectionBeacon VerticalAlignment="Center"
                               Width="{Binding $parent[controls:ConnectionStatusView].BeaconSize}"
                               Height="{Binding $parent[controls:ConnectionStatusView].BeaconSize}"
                               State="{Binding Connections.State}"/>
    <TextBlock x:Name="Label" Text="{Binding Connections.StatusLabel}" FontSize="11" FontWeight="SemiBold"
               VerticalAlignment="Center" TextWrapping="NoWrap"/>
  </StackPanel>
</UserControl>
