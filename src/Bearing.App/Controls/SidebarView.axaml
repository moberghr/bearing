<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Bearing.App.Controls"
             xmlns:vm="using:Bearing.App.ViewModels"
             x:Class="Bearing.App.Controls.SidebarView"
             x:DataType="vm:ShellViewModel">
        <DockPanel LastChildFill="True">
          <!-- Drag grip to resize the pane (updates SidePaneWidth → OpenPaneLength live). -->
          <Border DockPanel.Dock="Right" Width="5" Background="Transparent" Cursor="SizeWestEast"
                  PointerPressed="OnPaneResizePressed" PointerMoved="OnPaneResizeMoved"
                  PointerReleased="OnPaneResizeReleased"/>
        <Grid>

          <!-- ===== Connections / servers panel (connection → databases → objects tree) ===== -->
          <DockPanel Margin="8,8,6,6"
                     IsVisible="{Binding ActivePanel, Converter={StaticResource EnumToBool}, ConverterParameter=Schema}">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2,0,2,6">
              <TextBlock Grid.Column="0" Text="CONNECTIONS" FontSize="11" FontWeight="Bold"
                         Foreground="{DynamicResource Text.Dim}" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="＋" Padding="6,0" Click="OnAddConnectionClick"
                      ToolTip.Tip="Add connection"/>
            </Grid>
            <!-- Type-ahead fuzzy jump: letters/digits build a search, matches are tinted, Enter/typing
                 cycles to the next match (handled in code-behind OnSchemaTreeTextInput/KeyDown). -->
            <!-- KeyDown is hooked in the tunnel phase (code-behind) so Up/Down can pre-empt the tree's
                 own node navigation and cycle matches instead. -->
            <TreeView x:Name="SchemaTree" ItemsSource="{Binding Connections.ServerNodes}" Background="Transparent"
                      TextInput="OnSchemaTreeTextInput">
              <TreeView.Styles>
                <!-- Two-way bind each item's expansion to its node so children load lazily on first expand. -->
                <Style Selector="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}"/>
                </Style>
              </TreeView.Styles>
              <TreeView.DataTemplates>
                <!-- One template for every node type: matched by the base type, so subclasses share it.
                     Leaves have no children, so no expander is shown. -->
                <TreeDataTemplate DataType="vm:SchemaNodeViewModel" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent"
                              DoubleTapped="OnSchemaNodeDoubleTapped">
                    <StackPanel.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Use in current tab" Click="OnUseConnectionInTab" IsVisible="{Binding IsServer}"/>
                        <MenuItem Header="Refresh metadata" Click="OnRefreshServer" IsVisible="{Binding IsServer}"/>
                        <MenuItem Header="Edit…" Click="OnEditServer" IsVisible="{Binding IsServer}"/>
                        <MenuItem Header="Show definition" Click="OnShowDefinition" IsVisible="{Binding CanShowDefinition}"/>
                        <MenuItem Header="Copy name" Click="OnCopyNodeName"/>
                        <Separator IsVisible="{Binding IsServer}"/>
                        <MenuItem Header="Delete" Click="OnDeleteServer" IsVisible="{Binding IsServer}"/>
                      </ContextMenu>
                    </StackPanel.ContextMenu>
                    <Border Width="9" Height="9" CornerRadius="4" VerticalAlignment="Center"
                            IsVisible="{Binding BadgeColor, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Background="{Binding BadgeColor, Converter={StaticResource HexBrush}}"/>
                    <!-- Vector icon (server/database) when the node provides one; else the text glyph. -->
                    <Path Data="{Binding IconKey, Converter={StaticResource ResourceGeometry}}"
                          IsVisible="{Binding IconKey, Converter={x:Static ObjectConverters.IsNotNull}}"
                          Stroke="{Binding IconColorHex, Converter={StaticResource HexBrush}}" StrokeThickness="1.4"
                          StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="15" Height="15"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Glyph}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}"
                               IsVisible="{Binding IconKey, Converter={x:Static ObjectConverters.IsNull}}"/>
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                               Background="{Binding IsMatch, Converter={StaticResource MatchHighlight}}"
                               Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock Text="{Binding Detail}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Text.Dim}"/>
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </DockPanel>

          <!-- ===== Scripts panel (design §3): folder tree + filter ===== -->
          <DockPanel Margin="8,8,6,6"
                     IsVisible="{Binding ActivePanel, Converter={StaticResource EnumToBool}, ConverterParameter=Scripts}">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="2,0,2,6">
              <TextBlock Grid.Column="0" Text="SCRIPTS" FontSize="11" FontWeight="Bold"
                         Foreground="{DynamicResource Text.Dim}" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Classes="rail" Theme="{StaticResource RailButton}" Width="26" Height="26"
                      Click="OnNewScriptFolderClick" ToolTip.Tip="New folder">
                <controls:LineIcon Data="{StaticResource Icon.Folder}" Width="20" Height="20"/>
              </Button>
              <Button Grid.Column="2" Content="＋" Padding="6,0" Click="OnNewTabClick"
                      ToolTip.Tip="New script (Ctrl+T)"/>
            </Grid>
            <TextBox DockPanel.Dock="Top" Text="{Binding Scripts.ScriptFilter, Mode=TwoWay}"
                     PlaceholderText="Filter scripts…" Margin="0,0,0,6"/>
            <!-- Enter opens the selected script; drag a script onto a folder to move it (OnScripts* handlers). -->
            <!-- SelectedItem is bound so a view-model can set it: "Reveal in Scripts" selects a tab's file,
                 and the selection then survives the wholesale rebuild in RefreshScripts. -->
            <!-- The tree's own edge lights up while a drag would land in the scripts root (dropping on
                 anything that isn't a folder row moves the script there). Kept to a soft 1px line that is
                 always there — transparent when idle — so nothing reflows when it appears. -->
            <TreeView x:Name="ScriptsTree" ItemsSource="{Binding Scripts.ScriptNodes}" Background="Transparent"
                      SelectedItem="{Binding Scripts.SelectedNode, Mode=TwoWay}"
                      BorderThickness="1" CornerRadius="4"
                      BorderBrush="{Binding Scripts.IsRootDropTarget, Converter={StaticResource DropTarget}, ConverterParameter=Border}"
                      KeyDown="OnScriptsTreeKeyDown" DragDrop.AllowDrop="True"
                      DragDrop.DragOver="OnScriptDragOver" DragDrop.DragLeave="OnScriptDragLeave"
                      DragDrop.Drop="OnScriptDropOnRoot">
              <TreeView.Styles>
                <Style Selector="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}"/>
                </Style>
              </TreeView.Styles>
              <TreeView.DataTemplates>
                <!-- Folder: amber glyph + name + right-aligned count. A drop target for scripts. -->
                <TreeDataTemplate DataType="vm:ScriptFolderViewModel" ItemsSource="{Binding Children}">
                  <!-- A Border, not a bare Grid, so the drop highlight is a rounded inset chip rather than a
                       flat band running to the pane's edge. No BorderThickness: the tint appears and goes
                       without moving the row, and the fill alone reads as a target without competing with
                       the (blue) selection. Transparent otherwise, so the row still takes the pointer. -->
                  <Border Background="{Binding IsDropTarget, Converter={StaticResource DropTarget}}"
                          CornerRadius="4" Margin="0,1,6,1" Padding="2,0"
                          DragDrop.AllowDrop="True" DragDrop.DragOver="OnScriptDragOver" DragDrop.Drop="OnScriptDropOnFolder">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="New subfolder…" Click="OnNewSubfolderClick"/>
                        <MenuItem Header="New script here…" Click="OnNewScriptInFolderClick"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Curated folders get the amber folder glyph; the app-owned scratch folder is dimmed
                         and marked so it reads as a holding pen rather than something the user curated. -->
                    <Path Grid.Column="0" Data="{StaticResource Icon.Folder}" Stroke="#E3B457"
                          StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform"
                          Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"
                          IsVisible="{Binding !IsScratch}"/>
                    <Path Grid.Column="0" Data="{StaticResource Icon.File}" Stroke="{DynamicResource Text.Dim}"
                          StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform"
                          Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"
                          IsVisible="{Binding IsScratch}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Text.Primary}"/>
                      <Border IsVisible="{Binding IsScratch}" VerticalAlignment="Center"
                              Background="{DynamicResource Bg.TileActive}" CornerRadius="3" Padding="4,0">
                        <TextBlock Text="auto" FontSize="10" Foreground="{DynamicResource Text.Dim}"/>
                      </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Count}" VerticalAlignment="Center"
                               FontSize="11" Margin="6,0,4,0" Foreground="{DynamicResource Text.Faint}"/>
                  </Grid>
                  </Border>
                </TreeDataTemplate>
                <!-- Script leaf: file glyph + name + unsaved dot. Draggable to a folder. -->
                <TreeDataTemplate DataType="vm:ScriptItem">
                  <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent"
                              DoubleTapped="OnScriptActivated" PointerPressed="OnScriptPointerPressed"
                              PointerMoved="OnScriptPointerMoved">
                    <StackPanel.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Open" Click="OnOpenScriptClick"/>
                        <MenuItem Header="Rename…" Click="OnRenameScriptClick"/>
                        <Separator/>
                        <MenuItem Header="Delete…" Click="OnDeleteScriptClick"/>
                      </ContextMenu>
                    </StackPanel.ContextMenu>
                    <Path Data="{StaticResource Icon.File}" Stroke="{DynamicResource Text.Dim}"
                          StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform"
                          Width="14" Height="14" VerticalAlignment="Center"/>
                    <!-- Renaming swaps the label for a box in place (#39): Enter commits, Esc cancels,
                         clicking away commits. Both live in the tree; only one is visible. -->
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Primary}"
                               IsVisible="{Binding !IsRenaming}"/>
                    <TextBox Classes="inline" Text="{Binding RenameDraft, Mode=TwoWay}"
                             IsVisible="{Binding IsRenaming}" MinWidth="90" VerticalAlignment="Center"
                             KeyDown="OnScriptRenameKeyDown" LostFocus="OnScriptRenameLostFocus"/>
                    <TextBlock Text="●" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent.Brand}" ToolTip.Tip="Unsaved changes"
                               IsVisible="{Binding IsUnsaved}"/>
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </DockPanel>

          <!-- ===== History panel (design §4): day-grouped, filterable ===== -->
          <DockPanel Margin="8,8,6,6"
                     IsVisible="{Binding ActivePanel, Converter={StaticResource EnumToBool}, ConverterParameter=History}">
            <TextBlock DockPanel.Dock="Top" Text="HISTORY" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource Text.Dim}" Margin="2,0,2,6"/>
            <TextBox DockPanel.Dock="Top" Text="{Binding History.SearchText, Mode=TwoWay}"
                     PlaceholderText="Search history…" KeyDown="OnHistorySearchKeyDown" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
              <RadioButton Theme="{StaticResource PillToggle}" GroupName="histfilter" Content="All"
                           IsChecked="{Binding History.Filter, Converter={StaticResource EnumToBool}, ConverterParameter=All, Mode=TwoWay}"/>
              <RadioButton Theme="{StaticResource PillToggle}" GroupName="histfilter" Content="✓ ok"
                           IsChecked="{Binding History.Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Ok, Mode=TwoWay}"/>
              <RadioButton Theme="{StaticResource PillToggle}" GroupName="histfilter" Content="✕ error"
                           IsChecked="{Binding History.Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Error, Mode=TwoWay}"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding History.Status}" FontSize="11"
                       Foreground="{DynamicResource Text.Faint}" Margin="2,4,2,0"/>
            <!-- List (fills) · drag splitter · query preview (resizable, hidden until a row is selected).
                 HistoryPreviewRow is a real pixel row so the GridSplitter actually resizes the pane;
                 code-behind sets it to 0 when nothing is selected. -->
            <Grid x:Name="HistoryGrid">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="0"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0">
              <ItemsControl ItemsSource="{Binding History.Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryDayGroup">
                    <StackPanel Margin="0,0,0,8">
                      <TextBlock Text="{Binding Caption}" FontSize="10" FontWeight="Bold"
                                 Foreground="{DynamicResource Text.Faint}" Margin="2,2,2,3"/>
                      <ListBox Classes="history" ItemsSource="{Binding Rows}" Background="Transparent"
                               BorderThickness="0" Padding="0"
                               SelectedItem="{ReflectionBinding DataContext.History.SelectedRow, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:HistoryRowViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent"
                                  DoubleTapped="OnHistoryRowActivated" ToolTip.Tip="{Binding Detail}">
                              <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                      Background="{Binding ConnectionColor, Converter={StaticResource HexBrush}}"/>
                              <TextBlock Grid.Column="1" Text="{Binding DisplayQuery}" TextTrimming="CharacterEllipsis"
                                         FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                         VerticalAlignment="Center"
                                         Foreground="{Binding QueryColorHex, Converter={StaticResource HexBrush}}"/>
                              <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="11" Margin="8,0,0,0"
                                         VerticalAlignment="Center" Foreground="{DynamicResource Text.Faint}"/>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows" Background="{DynamicResource Border}"
                          IsVisible="{Binding History.SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Border Grid.Row="2" Margin="0,6,0,0" VerticalAlignment="Stretch"
                    Background="{DynamicResource Bg.Window}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="6"
                    IsVisible="{Binding History.SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}">
              <DockPanel Margin="6">
                <TextBlock DockPanel.Dock="Top" Text="PREVIEW" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding History.SelectedRow.Sql, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                         Background="Transparent" BorderThickness="0"
                         TextWrapping="NoWrap" AcceptsReturn="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
              </DockPanel>
            </Border>
            </Grid>
          </DockPanel>

        </Grid>
        </DockPanel>
</UserControl>
