<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI library (App.axaml, Views, ViewModels). The executable entry point lives in
       Bearing.Desktop so this stays referenceable from tests without an entry-point clash. -->
  <PropertyGroup>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Brand/app icon assets (window icon, in-app mark) shipped as Avalonia resources. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bearing.Core\Bearing.Core.csproj" />
    <ProjectReference Include="..\Bearing.Sql\Bearing.Sql.csproj" />
    <ProjectReference Include="..\Bearing.Data\Bearing.Data.csproj" />
    <ProjectReference Include="..\Bearing.Persistence\Bearing.Persistence.csproj" />
    <ProjectReference Include="..\Bearing.Updates\Bearing.Updates.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

</Project>
