<Project Sdk="Microsoft.NET.Sdk">

  <!-- Thin desktop entry point. All UI lives in Squirrel.App. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>squirrel</AssemblyName>
  </PropertyGroup>

  <!-- Startup: precompile IL→native on publish (ReadyToRun) to cut JIT time in the ~490ms
       runtime/Avalonia init phase. Applies to `dotnet publish` (the shipped build), not dev run. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Squirrel.App\Squirrel.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

</Project>
