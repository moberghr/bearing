<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Bearing.Sql: the SQL parsing + completion core.
      * ANTLR4 PostgreSQL and T-SQL grammars (grammars-v4), generated at build time by Antlr4BuildTasks.
      * antlr4-c3 CodeCompletionCore (vendored C# port) to compute candidates at the caret.
    Kept free of Npgsql / Avalonia so the completion engine is unit-testable in isolation.
  -->

  <PropertyGroup>
    <!-- Generated parser + the vendored grammar base classes live in the GLOBAL namespace
         (the grammars-v4 base classes declare no namespace), so we do not set an ANTLR package. -->

    <!--
      ANT01 = ANTLR warning(146) "non-fragment lexer rule can match the empty string", raised twice by the
      vendored lexer (PostgreSQLLexer.g4:1441,1456). Both rules are deliberately empty: they are the
      "escape string constant was NOT continued" fallthroughs whose only job is `-> skip, popMode`, so the
      empty match IS the mechanism. Silencing beats editing them — a fix would change how `E'…'`
      continuation lexes, in a grammar we vendor rather than author.
      Scope note: MSBuild suppression is per-project, not per-file, so this hides any future ANT01 in this
      project too. Drop the property temporarily after updating vendor/grammars-v4 to re-read the warnings.
    -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);ANT01</MSBuildWarningsAsMessages>

    <!--
      CS0108 = "member hides inherited member", raised three times inside the GENERATED TSqlParser.cs
      (Alter_message_typeContext, Message_statementContext, KeywordContext). T-SQL has an EMPTY keyword, so
      ANTLR emits an `EMPTY()` token accessor on each context that can hold one — and that hides
      ParserRuleContext.EMPTY from the runtime. Nothing calls either, and the collision is a name clash
      between a vendored grammar's keyword list and the ANTLR runtime, not a mistake in it.
      Scope note, as above: suppression is per-project, so this hides any future CS0108 in this project's
      own source too. Bearing.Sql is static helpers with no inheritance, which is what makes that
      acceptable here; drop the property temporarily after updating vendor/grammars-v4 to re-read it.
    -->
    <NoWarn>$(NoWarn);CS0108</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bearing.Core\Bearing.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" />
    <PackageReference Include="Antlr4BuildTasks" PrivateAssets="all" />
  </ItemGroup>

  <!-- Grammar. Parser depends on Lexer (tokenVocab); Antlr4BuildTasks orders them. -->
  <ItemGroup>
    <Antlr4 Include="..\..\vendor\grammars-v4\postgresql\PostgreSQLLexer.g4">
      <Listener>false</Listener>
      <Visitor>false</Visitor>
    </Antlr4>
    <Antlr4 Include="..\..\vendor\grammars-v4\postgresql\PostgreSQLParser.g4">
      <Listener>false</Listener>
      <Visitor>true</Visitor>
    </Antlr4>
  </ItemGroup>

  <!--
    T-SQL grammar (grammars-v4 sql/tsql), for SQL Server completion and folding. Cheaper to vendor
    than the PostgreSQL one above: it declares no superClass, so it needs none of the hand-written
    base classes, and `caseInsensitive = true` in its lexer means no keyword-casing scaffolding
    either. Lexer before parser, the same tokenVocab ordering Antlr4BuildTasks resolves for Postgres.
  -->
  <ItemGroup>
    <Antlr4 Include="..\..\vendor\grammars-v4\tsql\TSqlLexer.g4">
      <Listener>false</Listener>
      <Visitor>false</Visitor>
    </Antlr4>
    <Antlr4 Include="..\..\vendor\grammars-v4\tsql\TSqlParser.g4">
      <Listener>false</Listener>
      <Visitor>false</Visitor>
    </Antlr4>
  </ItemGroup>

  <!-- Vendored C#: grammar base classes + error listeners (required by the grammar's superClass). -->
  <ItemGroup>
    <Compile Include="..\..\vendor\grammars-v4\postgresql\PostgreSQLLexerBase.cs" Link="Grammar\PostgreSQLLexerBase.cs" />
    <Compile Include="..\..\vendor\grammars-v4\postgresql\PostgreSQLParserBase.cs" Link="Grammar\PostgreSQLParserBase.cs" />
    <Compile Include="..\..\vendor\grammars-v4\postgresql\LexerDispatchingErrorListener.cs" Link="Grammar\LexerDispatchingErrorListener.cs" />
    <Compile Include="..\..\vendor\grammars-v4\postgresql\ParserDispatchingErrorListener.cs" Link="Grammar\ParserDispatchingErrorListener.cs" />
  </ItemGroup>

  <!-- Vendored antlr4-c3 (C# port), namespace Antlr4CodeCompletion.Core.CodeCompletion. -->
  <ItemGroup>
    <Compile Include="..\..\vendor\antlr4-c3\*.cs" Link="Antlr4C3\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
