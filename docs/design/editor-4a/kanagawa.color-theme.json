{
  "name": "Kanagawa (Squirrel)",
  "type": "dark",
  "colors": {
    "editor.background": "#1F1F28",
    "editor.foreground": "#DCD7BA",
    "editorLineNumber.foreground": "#54546D",
    "editorLineNumber.activeForeground": "#FF9E3B",
    "editor.lineHighlightBackground": "#252535",
    "editor.selectionBackground": "#2D4F67",
    "editorCursor.foreground": "#C8C093"
  },
  "tokenColors": [
    {
      "name": "Base text",
      "scope": ["source.sql", "text"],
      "settings": { "foreground": "#DCD7BA" }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#727169", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.other.sql",
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "storage",
        "storage.type",
        "keyword.operator"
      ],
      "settings": { "foreground": "#957FB8" }
    },
    {
      "name": "Functions",
      "scope": [
        "support.function",
        "entity.name.function",
        "meta.function-call",
        "support.function.aggregate.sql"
      ],
      "settings": { "foreground": "#7E9CD8" }
    },
    {
      "name": "Numbers / constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other"
      ],
      "settings": { "foreground": "#FFA066" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted.single.sql",
        "string.quoted.double.sql",
        "punctuation.definition.string"
      ],
      "settings": { "foreground": "#98BB6C" }
    },
    {
      "name": "Types / tables",
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.table",
        "constant.other.database-name.sql",
        "constant.other.table-name.sql"
      ],
      "settings": { "foreground": "#7AA89F" }
    },
    {
      "name": "Code values / identifiers",
      "scope": ["variable", "meta.column", "entity.name"],
      "settings": { "foreground": "#C8C093" }
    },
    {
      "name": "Operators / punctuation",
      "scope": ["punctuation", "keyword.operator.comparison", "keyword.operator.math"],
      "settings": { "foreground": "#C0A36E" }
    }
  ]
}
