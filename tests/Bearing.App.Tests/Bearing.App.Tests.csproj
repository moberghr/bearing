<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bearing.App\Bearing.App.csproj" />
    <ProjectReference Include="..\..\src\Bearing.Core\Bearing.Core.csproj" />
    <ProjectReference Include="..\..\src\Bearing.Data\Bearing.Data.csproj" />
    <ProjectReference Include="..\..\src\Bearing.Persistence\Bearing.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with Bearing.Data.Tests: one definition of the test server's defaults (see PgTestServer). -->
    <Compile Include="..\Shared\PgTestServer.cs" Link="Shared\PgTestServer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
    <!-- Headless UI tests (#62): substitutes the windowing platform in-process, so real controls can be
         realized and driven without a display server. Not the .XUnit shim — see Directory.Packages.props. -->
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>

</Project>
