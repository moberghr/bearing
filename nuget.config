<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Hermetic: ignore any user/global feeds (e.g. private GitHub packages) and use nuget.org only. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
